<!-- components/calc-car/calc-car.wxml -->
<view class="page-body">
  <!-- 1. 顶部模式切换 (全包落地与车贷 / 油电成本对比) -->
  <view class="segmented-control card-shadow">
    <view
      class="segment-btn {{carTab === 'landing' ? 'active' : ''}}"
      hover-class="touch-active"
      bindtap="onCarTabChange"
      data-tab="landing"
    >
      落地总价与车贷分期
    </view>
    <view
      class="segment-btn {{carTab === 'running' ? 'active' : ''}}"
      hover-class="touch-active"
      bindtap="onCarTabChange"
      data-tab="running"
    >
      油车 vs 电车成本对比
    </view>
  </view>

  <!-- 2. Tab 1: 全包落地价与车贷分期 -->
  <view wx:if="{{carTab === 'landing'}}">
    <view class="form-card card-shadow">
      <!-- 动力类型 -->
      <view class="form-item">
        <view class="item-header">
          <text class="item-label">车辆动力类型 (影响购置税与车船税)</text>
        </view>
        <view class="type-segmented">
          <view
            class="type-btn {{carPowerType === 'fuel' ? 'type-active' : ''}}"
            hover-class="touch-active"
            bindtap="onPowerTypeChange"
            data-power="fuel"
          >
            燃油车
          </view>
          <view
            class="type-btn {{carPowerType === 'electric' ? 'type-active' : ''}}"
            hover-class="touch-active"
            bindtap="onPowerTypeChange"
            data-power="electric"
          >
            纯电动 (免税)
          </view>
          <view
            class="type-btn {{carPowerType === 'phev' ? 'type-active' : ''}}"
            hover-class="touch-active"
            bindtap="onPowerTypeChange"
            data-power="phev"
          >
            插混 / 增程
          </view>
        </view>
      </view>

      <!-- 裸车价格输入 -->
      <view class="form-item">
        <view class="item-header">
          <text class="item-label">裸车成交价</text>
          <text class="item-unit">折合 ¥{{landingResult.formatCarPrice}} 元</text>
        </view>
        <view class="input-wrap">
          <input
            class="amount-input"
            type="digit"
            value="{{carPriceWan}}"
            bindinput="onCarPriceInput"
            bindconfirm="onConfirmInput"
            bindblur="onBlurInput"
            placeholder="15"
          />
          <text class="unit-text">万元</text>
        </view>
        <!-- 快捷预设 -->
        <view class="quick-presets">
          <view
            wx:for="{{[10, 15, 25, 35, 50]}}"
            wx:key="*this"
            class="chip {{carPriceWan === item ? 'chip-active' : ''}}"
            hover-class="touch-active"
            bindtap="selectCarPricePreset"
            data-val="{{item}}"
          >
            {{item}}万
          </view>
        </view>
      </view>

      <!-- 购车方式切换 (全款 / 分期) -->
      <view class="form-item item-border-top">
        <view class="item-header">
          <text class="item-label">购车付款方式</text>
        </view>
        <view class="type-segmented">
          <view
            class="type-btn {{buyWay === 'loan' ? 'type-active' : ''}}"
            hover-class="touch-active"
            bindtap="onBuyWayChange"
            data-way="loan"
          >
            贷款分期 (含IRR反解)
          </view>
          <view
            class="type-btn {{buyWay === 'full' ? 'type-active' : ''}}"
            hover-class="touch-active"
            bindtap="onBuyWayChange"
            data-way="full"
          >
            全款一次性支付
          </view>
        </view>
      </view>

      <!-- 贷款分期专用参数 -->
      <view wx:if="{{buyWay === 'loan'}}" class="loan-configs animate-fade-in">
        <!-- 首付比例 -->
        <view class="form-item">
          <view class="item-header">
            <text class="item-label">首付比例</text>
            <text class="item-value-text">首付 ¥{{carLoanResult.formatDownPaymentAmount}} 元</text>
          </view>
          <view class="year-chips">
            <view
              class="chip {{downPaymentRatio === 0.2 ? 'chip-active' : ''}}"
              hover-class="touch-active"
              bindtap="selectDownPaymentRatio"
              data-ratio="0.2"
            >
              首付20%
            </view>
            <view
              class="chip {{downPaymentRatio === 0.3 ? 'chip-active' : ''}}"
              hover-class="touch-active"
              bindtap="selectDownPaymentRatio"
              data-ratio="0.3"
            >
              首付30%
            </view>
            <view
              class="chip {{downPaymentRatio === 0.5 ? 'chip-active' : ''}}"
              hover-class="touch-active"
              bindtap="selectDownPaymentRatio"
              data-ratio="0.5"
            >
              首付50%
            </view>
          </view>
        </view>

        <!-- 分期月数 -->
        <view class="form-item">
          <view class="item-header">
            <text class="item-label">分期期限</text>
            <text class="item-value-text">贷款 ¥{{carLoanResult.formatLoanPrincipal}} 元</text>
          </view>
          <view class="year-chips">
            <view
              wx:for="{{[12, 24, 36, 60]}}"
              wx:key="*this"
              class="chip {{carLoanMonths === item ? 'chip-active' : ''}}"
              hover-class="touch-active"
              bindtap="selectCarLoanMonths"
              data-months="{{item}}"
            >
              {{item}}期 ({{item / 12}}年)
            </view>
          </view>
        </view>

        <!-- 名义年利率 & 金融服务费 -->
        <view class="dual-inputs-row">
          <view class="half-input-col">
            <text class="sub-label">名义年利率(%)</text>
            <view class="small-input-wrap">
              <input
                class="small-input"
                type="digit"
                value="{{nominalRate}}"
                bindinput="onNominalRateInput"
                placeholder="3.0"
              />
              <text class="unit-text">%</text>
            </view>
          </view>
          <view class="half-input-col">
            <text class="sub-label">4S店金融服务费</text>
            <view class="small-input-wrap">
              <input
                class="small-input"
                type="number"
                value="{{financeServiceFee}}"
                bindinput="onFinanceFeeInput"
                placeholder="3000"
              />
              <text class="unit-text">元</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 4S 店陷阱预警条 (命中时展示) -->
    <view wx:if="{{buyWay === 'loan' && carLoanResult.trapWarning}}" class="blind-warning-card card-shadow animate-fade-in">
      <view class="blind-top">
        <t-icon name="error-circle-filled" size="36rpx" color="#DC2626" />
        <text class="blind-title">{{carLoanResult.trapWarning.title}}</text>
      </view>
      <text class="blind-desc">{{carLoanResult.trapWarning.tip}}</text>
    </view>

    <!-- 结果看板 (全款 / 分期) -->
    <view class="result-dashboard card-shadow-lg">
      <view class="dash-header">
        <text class="dash-subtitle">{{buyWay === 'loan' ? '车贷每月还款 (等额本息)' : '全款全包落地总价'}}</text>
        <t-tag wx:if="{{buyWay === 'loan'}}" size="small" theme="{{carLoanResult.realAnnualIRR > nominalRate ? 'danger' : 'primary'}}" variant="dark">
          真实IRR: {{carLoanResult.realAnnualIRR}}%
        </t-tag>
        <t-tag wx:else size="small" theme="success" variant="light">一次结清</t-tag>
      </view>

      <!-- 大字号主金额 -->
      <view class="dash-main-amount">
        <text class="amount-symbol">¥</text>
        <text class="amount-integer">{{buyWay === 'loan' ? carLoanResult.formatMonthlyPayment : landingResult.formatTotalLandingPrice}}</text>
        <text class="amount-unit">{{buyWay === 'loan' ? '/月' : ''}}</text>
      </view>

      <view class="dash-sub-decrease">
        <text wx:if="{{buyWay === 'loan'}}">
          首付开支 ¥{{carLoanResult.formatDownPaymentAmount}} · 利息总计 ¥{{carLoanResult.formatTotalInterest}} · 4S服务费 ¥{{carLoanResult.formatFinanceServiceFee}}
        </text>
        <text wx:else>
          裸车 ¥{{landingResult.formatCarPrice}} · 购置税 ¥{{landingResult.formatPurchaseTax}} · 商业险 ¥{{landingResult.formatCommercialInsurance}}
        </text>
      </view>

      <!-- 汇总三列指标 -->
      <view class="dash-stats-grid">
        <view class="stat-col">
          <text class="stat-label">{{buyWay === 'loan' ? '分期总开支' : '不含税车价'}}</text>
          <text class="stat-val">¥{{buyWay === 'loan' ? carLoanResult.formatTotalCostWithFee : landingResult.priceExclVat}}</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-col">
          <text class="stat-label">购置税{{carPowerType === 'electric' ? '(全免)' : ''}}</text>
          <text class="stat-val {{carPowerType === 'electric' ? 'color-green' : 'highlight-amber'}}">¥{{landingResult.formatPurchaseTax}}</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-col">
          <text class="stat-label">{{buyWay === 'loan' ? '真实年化IRR' : '商业车险'}}</text>
          <text class="stat-val font-bold {{buyWay === 'loan' && carLoanResult.realAnnualIRR > nominalRate ? 'color-red' : ''}}">
            {{buyWay === 'loan' ? carLoanResult.realAnnualIRR + '%' : '¥' + landingResult.formatCommercialInsurance}}
          </text>
        </view>
      </view>
    </view>

    <!-- 落地费用逐项拆解明细表 -->
    <view class="table-card card-shadow">
      <view class="table-header">
        <t-icon name="view-list" size="36rpx" color="#00288E" />
        <text class="table-title">全包落地明细拆解清单</text>
      </view>

      <view class="table-row table-head-row">
        <text class="col-item flex-2">费用科目</text>
        <text class="col-item flex-1 text-center font-bold">金额 (元)</text>
        <text class="col-item flex-2 text-center">政策与说明</text>
      </view>

      <view class="table-row">
        <text class="col-item flex-2 font-bold">裸车成交价</text>
        <text class="col-item flex-1 text-center">¥{{landingResult.formatCarPrice}}</text>
        <text class="col-item flex-2 text-center text-muted">发票成交总价</text>
      </view>

      <view class="table-row">
        <text class="col-item flex-2">车辆购置税</text>
        <text class="col-item flex-1 text-center font-bold {{carPowerType === 'electric' ? 'color-green' : ''}}">¥{{landingResult.formatPurchaseTax}}</text>
        <text class="col-item flex-2 text-center text-muted">{{landingResult.purchaseTaxRes.policyDesc}}</text>
      </view>

      <view class="table-row">
        <text class="col-item flex-2">车船使用税</text>
        <text class="col-item flex-1 text-center">¥{{landingResult.formatVehicleTax}}</text>
        <text class="col-item flex-2 text-center text-muted">{{carPowerType === 'electric' ? '纯电免征' : carDisplacement + 'L排量阶梯'}}</text>
      </view>

      <view class="table-row">
        <text class="col-item flex-2">法定交强险</text>
        <text class="col-item flex-1 text-center">¥{{landingResult.formatCompulsoryInsurance}}</text>
        <text class="col-item flex-2 text-center text-muted">家用{{carSeatCount}}座标准</text>
      </view>

      <view class="table-row">
        <text class="col-item flex-2">商业险预估</text>
        <text class="col-item flex-1 text-center">¥{{landingResult.formatCommercialInsurance}}</text>
        <text class="col-item flex-2 text-center text-muted">车损+三者300万</text>
      </view>

      <view class="table-row">
        <text class="col-item flex-2">上牌杂费</text>
        <text class="col-item flex-1 text-center">¥{{landingResult.formatRegistrationFee}}</text>
        <text class="col-item flex-2 text-center text-muted">4S店代办/自办工本</text>
      </view>
    </view>

    <!-- 快捷入口卡片 -->
    <view class="action-card-group">
      <view wx:if="{{buyWay === 'loan'}}" class="action-entry card-shadow" hover-class="touch-active" bindtap="toggleCarSchedulePopup">
        <view class="entry-left">
          <t-icon name="chart-bubble" size="40rpx" color="#00288E" />
          <view class="entry-texts">
            <text class="entry-title">查看 {{carLoanResult.totalMonths}} 期逐月还款账单</text>
            <text class="entry-sub">本金、利息与月供逐期明细</text>
          </view>
        </view>
        <t-icon name="chevron-right" size="36rpx" color="#94A3B8" />
      </view>

      <view class="action-entry card-shadow" hover-class="touch-active" bindtap="toggleDepreciationPopup">
        <view class="entry-left">
          <t-icon name="chart-bar" size="40rpx" color="#059669" />
          <view class="entry-texts">
            <text class="entry-title">二手车估值与 1~8 年保值率折旧曲线</text>
            <text class="entry-sub">推演各车龄预估残值与保值梯队</text>
          </view>
        </view>
        <t-icon name="chevron-right" size="36rpx" color="#94A3B8" />
      </view>
    </view>
  </view>

  <!-- 3. Tab 2: 油车 vs 电车全周期养车成本对比 -->
  <view wx:if="{{carTab === 'running'}}">
    <view class="form-card card-shadow">
      <view class="form-item">
        <view class="item-header">
          <text class="item-label">预估年行驶里程</text>
          <text class="item-value-text">{{annualMileage}} 公里/年</text>
        </view>
        <view class="input-wrap">
          <input
            class="amount-input"
            type="number"
            value="{{annualMileage}}"
            bindinput="onAnnualMileageInput"
            placeholder="15000"
          />
          <text class="unit-text">公里/年</text>
        </view>
        <view class="quick-presets">
          <view
            wx:for="{{[10000, 15000, 20000, 30000]}}"
            wx:key="*this"
            class="chip {{annualMileage === item ? 'chip-active' : ''}}"
            hover-class="touch-active"
            bindtap="selectAnnualMileagePreset"
            data-value="{{item}}"
          >
            {{item / 10000}}万公里
          </view>
        </view>
      </view>
    </view>

    <!-- 省钱大看板 -->
    <view class="highlight-banner card-shadow-lg">
      <view class="banner-top">
        <view class="badge-tag">
          <t-icon name="check-circle" size="28rpx" color="#059669" />
          <text class="badge-text">电车养车省钱推演</text>
        </view>
        <text class="banner-date">按年跑 {{annualMileage}} 公里测算</text>
      </view>
      <view class="banner-main">
        <text class="save-title">电车每年综合可省支出</text>
        <view class="save-amount">
          <text class="symbol">¥</text>
          <text class="num">{{runningCostResult.formatAnnualTotalSaved}}</text>
          <text class="unit">/年</text>
        </view>
      </view>
      <view class="banner-tip">
        <text>5年累计省下 ¥{{runningCostResult.formatSave5Years}} 元 · {{runningCostResult.breakevenDesc}}</text>
      </view>
    </view>

    <!-- 油车 vs 电车 双栏并排对比卡片 -->
    <view class="compare-cards">
      <!-- 燃油车卡片 -->
      <view class="scheme-card scheme-normal card-shadow">
        <view class="scheme-header">
          <view class="scheme-title-wrap">
            <text class="scheme-tag tag-gray">传统燃油车</text>
            <text class="scheme-name">综合油耗 7.5L/100km</text>
          </view>
          <t-tag theme="default" variant="light" size="small">92#汽油</t-tag>
        </view>
        <view class="tax-total">
          <text class="label">年度总养车成本</text>
          <text class="val color-red">¥ {{runningCostResult.fuelCar.formatTotalAnnualCost}}</text>
        </view>
        <view class="scheme-details">
          <view class="s-row">
            <text class="s-name">年度燃油能耗费</text>
            <text class="s-val">¥ {{runningCostResult.fuelCar.formatEnergyCost}}</text>
          </view>
          <view class="s-row">
            <text class="s-name">年度常规保养</text>
            <text class="s-val">¥ {{runningCostResult.fuelCar.maintenanceCost}}</text>
          </view>
          <view class="s-row">
            <text class="s-name">折合每公里费用</text>
            <text class="s-val font-bold">¥ {{runningCostResult.fuelCar.costPerKm}} 元/km</text>
          </view>
        </view>
      </view>

      <!-- 纯电动车卡片 -->
      <view class="scheme-card scheme-recommend card-shadow">
        <view class="scheme-header">
          <view class="scheme-title-wrap">
            <text class="scheme-tag">纯电动汽车</text>
            <text class="scheme-name">综合电耗 14.5kWh/100km</text>
          </view>
          <t-tag theme="success" variant="dark" size="small">极低能耗</t-tag>
        </view>
        <view class="tax-total">
          <text class="label">年度总养车成本</text>
          <text class="val color-green">¥ {{runningCostResult.electricCar.formatTotalAnnualCost}}</text>
        </view>
        <view class="scheme-details">
          <view class="s-row">
            <text class="s-name">年度充电电费</text>
            <text class="s-val color-green">¥ {{runningCostResult.electricCar.formatEnergyCost}}</text>
          </view>
          <view class="s-row">
            <text class="s-name">年度常规保养</text>
            <text class="s-val">¥ {{runningCostResult.electricCar.maintenanceCost}}</text>
          </view>
          <view class="s-row">
            <text class="s-name">折合每公里费用</text>
            <text class="s-val font-bold color-green">¥ {{runningCostResult.electricCar.costPerKm}} 元/km</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 4. 抽屉区 -->
  <!-- 4.1 车贷分期逐月账单明细抽屉 -->
  <t-popup visible="{{showCarSchedulePopup}}" placement="bottom" bind:visible-change="toggleCarSchedulePopup">
    <view class="schedule-drawer">
      <view class="drawer-header">
        <view class="drawer-title-group">
          <text class="drawer-title">车贷 {{carLoanResult.totalMonths}} 期还款计划明细</text>
          <text class="drawer-sub">贷款本金 ¥{{carLoanResult.formatLoanPrincipal}} · 真实年化IRR {{carLoanResult.realAnnualIRR}}%</text>
        </view>
        <view class="drawer-close" bindtap="toggleCarSchedulePopup">
          <t-icon name="close" size="40rpx" color="#64748B" />
        </view>
      </view>

      <view class="schedule-thead">
        <text class="th th-month">期数</text>
        <text class="th th-pay">月供(元)</text>
        <text class="th th-prin">偿还本金</text>
        <text class="th th-inte">偿还利息</text>
        <text class="th th-rest">剩余本金</text>
      </view>

      <scroll-view class="schedule-scroll" scroll-y enable-flex>
        <view wx:for="{{carLoanResult.schedule}}" wx:key="month" class="schedule-row">
          <text class="td td-month">{{item.monthName}}</text>
          <text class="td td-pay font-bold">¥{{item.formatPayment}}</text>
          <text class="td td-prin">¥{{item.formatPrincipal}}</text>
          <text class="td td-inte text-muted">¥{{item.formatInterest}}</text>
          <text class="td td-rest text-muted">¥{{item.formatRemaining}}</text>
        </view>
      </scroll-view>
    </view>
  </t-popup>

  <!-- 4.2 二手车 1~8 年保值率与折旧残值抽屉 -->
  <t-popup visible="{{showDepreciationPopup}}" placement="bottom" bind:visible-change="toggleDepreciationPopup">
    <view class="schedule-drawer">
      <view class="drawer-header">
        <view class="drawer-title-group">
          <text class="drawer-title">二手车 1~8 年保值率与残值推演</text>
          <text class="drawer-sub">新车总价 ¥{{depreciationResult.carPrice / 10000}}万 · 综合车况与里程系数评估</text>
        </view>
        <view class="drawer-close" bindtap="toggleDepreciationPopup">
          <t-icon name="close" size="40rpx" color="#64748B" />
        </view>
      </view>

      <view class="schedule-thead">
        <text class="th th-month">车龄</text>
        <text class="th th-pay">保值率</text>
        <text class="th th-prin">预估残值</text>
        <text class="th th-inte">折损金额</text>
        <text class="th th-rest">折旧率</text>
      </view>

      <scroll-view class="schedule-scroll" scroll-y enable-flex>
        <view wx:for="{{depreciationResult.curve}}" wx:key="year" class="schedule-row">
          <text class="td td-month">{{item.yearName}}</text>
          <text class="td td-pay font-bold color-green">{{item.residualRatePercent}}%</text>
          <text class="td td-prin font-bold">¥{{item.residualPriceWan}}万</text>
          <text class="td td-inte text-muted">¥{{(depreciationResult.carPrice - item.residualPrice) / 10000}}万</text>
          <text class="td td-rest text-muted">{{100 - item.residualRatePercent}}%</text>
        </view>
      </scroll-view>
    </view>
  </t-popup>
</view>
