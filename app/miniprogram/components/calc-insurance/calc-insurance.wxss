/* calc-insurance.wxss */
.compare-progress-wrap {
  margin: 24rpx 0 16rpx;
  background: #F1F5F9;
  border-radius: 16rpx;
  padding: 24rpx;
}

.compare-title-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: var(--text-regular);
}

.compare-bar-track {
  height: 20rpx;
  background: #E2E8F0;
  border-radius: 10rpx;
  overflow: hidden;
  display: flex;
}

.bar-social-fill {
  background: #00288E;
  height: 100%;
}

.bar-commercial-fill {
  background: #059669;
  height: 100%;
}

.bar-selfpay-fill {
  background: #EF4444;
  height: 100%;
}

.compare-legend {
  display: flex;
  gap: 24rpx;
  margin-top: 16rpx;
  font-size: 24rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.dot-social {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #00288E;
}

.dot-commercial {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #059669;
}

.dot-selfpay {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #EF4444;
}
