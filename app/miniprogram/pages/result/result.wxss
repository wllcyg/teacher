/* pages/result/result.wxss - 房贷、工资个税与购车用车高保真终端样式 */

.result-page {
  min-height: 100vh;
  background-color: var(--bg-color);
  box-sizing: border-box;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

.custom-navbar {
  --td-navbar-bg-color: #FFFFFF;
  border-bottom: 1rpx solid rgba(226, 232, 240, 0.8);
}

.page-body {
  padding: 24rpx 32rpx;
}

/* 1. 顶部分段切换 */
.segmented-control {
  display: flex;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--border-color);
}

.segment-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-muted);
  border-radius: 14rpx;
  transition: all 0.2s ease;
}

.segment-btn.active {
  background: var(--primary-color);
  color: #FFFFFF;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(0, 40, 142, 0.25);
}

/* 2. 表单卡片 */
.form-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--border-color);
}

.form-item {
  margin-bottom: 28rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.item-border-top {
  border-top: 1rpx solid #F1F5F9;
  padding-top: 28rpx;
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.item-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}

.item-unit {
  font-size: 22rpx;
  color: var(--text-light);
}

.item-action {
  font-size: 24rpx;
  color: var(--primary-color);
  font-weight: 600;
}

.item-value-text {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--primary-color);
}

.input-wrap {
  display: flex;
  align-items: center;
  background: #F8FAFC;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  border: 1rpx solid #E2E8F0;
}

.amount-input {
  flex: 1;
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text-main);
  height: 60rpx;
}

.unit-text {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-muted);
  margin-left: 12rpx;
}

.year-chips, .quick-presets {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
  flex-wrap: wrap;
}

.chip {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 24rpx;
  color: var(--text-regular);
  background: #F8FAFC;
  border: 1rpx solid #E2E8F0;
  border-radius: 12rpx;
  font-weight: 500;
  transition: all 0.2s ease;
  min-width: 120rpx;
}

.chip-active {
  background: #EFF4FF;
  border-color: var(--primary-color);
  color: var(--primary-color);
  font-weight: 700;
}

.type-segmented {
  display: flex;
  gap: 16rpx;
}

.type-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 24rpx;
  color: var(--text-regular);
  background: #F8FAFC;
  border: 1rpx solid #E2E8F0;
  border-radius: 12rpx;
  font-weight: 500;
  transition: all 0.2s ease;
}

.type-active {
  background: #EFF4FF;
  border-color: var(--primary-color);
  color: var(--primary-color);
  font-weight: 700;
}

/* 城市选择横滑 */
.city-scroll {
  width: 100%;
  white-space: nowrap;
}

.city-chips {
  display: flex;
  gap: 14rpx;
}

.city-chip {
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  color: #475569;
  background-color: #F1F5F9;
  border-radius: 100rpx;
  font-weight: 500;
  flex-shrink: 0;
  transition: all 0.2s ease;
}

.city-chip-active {
  background-color: #00288E;
  color: #FFFFFF;
  font-weight: 700;
}

/* 配置条入口 (五险一金 & 专项扣除) */
.config-entries {
  margin-top: 24rpx;
  border-top: 1rpx solid #F1F5F9;
  padding-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.config-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #F8FAFC;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  border: 1rpx solid #E2E8F0;
}

.bar-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.bar-info {
  display: flex;
  flex-direction: column;
}

.bar-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1E293B;
}

.bar-sub {
  font-size: 20rpx;
  color: #64748B;
  margin-top: 2rpx;
}

/* 3. 结果看板 */
.result-dashboard {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(0, 40, 142, 0.08);
}

.dash-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.dash-subtitle {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-muted);
}

.dash-main-amount {
  display: flex;
  align-items: baseline;
  margin-bottom: 12rpx;
}

.amount-symbol {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--primary-color);
  margin-right: 6rpx;
}

.amount-integer {
  font-size: 68rpx;
  font-weight: 800;
  color: var(--primary-color);
  letter-spacing: -1rpx;
  line-height: 1;
}

.amount-unit {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-muted);
  margin-left: 8rpx;
}

.dash-sub-decrease {
  font-size: 22rpx;
  color: var(--text-regular);
  margin-bottom: 24rpx;
  background-color: #F8FAFC;
  padding: 10rpx 16rpx;
  border-radius: 10rpx;
}

.dash-ratio-bar {
  margin-bottom: 32rpx;
}

.bar-track {
  display: flex;
  height: 16rpx;
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
  background: #E2E8F0;
}

.bar-fill-blue {
  background-color: var(--primary-color);
  transition: width 0.3s ease;
}

.bar-fill-amber {
  background-color: #D97706;
  transition: width 0.3s ease;
}

.ratio-labels {
  display: flex;
  justify-content: space-between;
}

.label-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.dot-blue { background-color: var(--primary-color); }
.dot-amber { background-color: #D97706; }

.ratio-txt {
  font-size: 22rpx;
  color: var(--text-regular);
}

.dash-stats-grid {
  display: flex;
  align-items: center;
  background: #F8FAFC;
  border-radius: 18rpx;
  padding: 20rpx 16rpx;
}

.stat-col {
  flex: 1;
  text-align: center;
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-bottom: 6rpx;
  display: block;
}

.stat-val {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-main);
}

.stat-unit {
  font-size: 20rpx;
  font-weight: 500;
  color: var(--text-muted);
  margin-left: 2rpx;
}

.stat-divider {
  width: 1rpx;
  height: 44rpx;
  background-color: #CBD5E1;
}

.highlight-amber {
  color: #D97706 !important;
}

/* 4. 增值操作入口 */
.action-card-group {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.action-entry {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border: 1rpx solid var(--border-color);
}

.entry-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.entry-texts {
  display: flex;
  flex-direction: column;
}

.entry-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-main);
}

.entry-sub {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
}

/* 辅助小工具卡片并排 */
.sub-tools-row {
  display: flex;
  gap: 20rpx;
}

.sub-tool-card {
  flex: 1;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  border: 1rpx solid var(--border-color);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.tool-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1E293B;
  margin-top: 4rpx;
}

.tool-sub {
  font-size: 20rpx;
  color: #94A3B8;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  padding: 20rpx 32rpx;
  border-top: 1rpx solid #E2E8F0;
  box-shadow: 0 -4rpx 16rpx rgba(11, 28, 48, 0.05);
  display: flex;
  gap: 20rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  z-index: 99;
}

.btn-share {
  flex: 1;
  height: 88rpx;
  border-radius: 24rpx;
  background: #EFF4FF;
  border: 1rpx solid #DCE9FF;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--primary-color);
  padding: 0;
  margin: 0;
  line-height: normal;
}

.btn-share::after {
  border: none;
}

.btn-poster {
  flex: 1.6;
  height: 88rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #00288E 0%, #0051D5 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
  box-shadow: 0 4rpx 14rpx rgba(0, 40, 142, 0.25);
}

/* 抽屉样式 */
.schedule-drawer {
  background: #FFFFFF;
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.drawer-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.drawer-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-main);
  display: block;
}

.drawer-sub {
  font-size: 22rpx;
  color: var(--text-muted);
  display: block;
  margin-top: 4rpx;
}

.drawer-close {
  padding: 8rpx;
}

.schedule-thead {
  display: flex;
  background: #F8FAFC;
  border-radius: 12rpx;
  padding: 16rpx 12rpx;
  margin-bottom: 12rpx;
}

.th {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-muted);
  text-align: right;
}

.td {
  font-size: 24rpx;
  color: var(--text-main);
  text-align: right;
}

.th-month, .td-month { flex: 1.2; text-align: left; }
.th-pay, .td-pay { flex: 1.5; }
.th-prin, .td-prin { flex: 1.3; }
.th-inte, .td-inte { flex: 1.2; }
.th-rest, .td-rest { flex: 1.4; }

.schedule-scroll {
  max-height: 55vh;
}

.schedule-row {
  display: flex;
  padding: 20rpx 12rpx;
  border-bottom: 1rpx solid #F1F5F9;
  align-items: center;
}

.row-year-end {
  background-color: #F8FAFC;
  border-bottom: 1.5rpx solid #E2E8F0;
}

.font-bold {
  font-weight: 700;
}

.text-muted {
  color: #64748B;
}

.color-green {
  color: #059669 !important;
}

.color-amber {
  color: #D97706 !important;
}

.color-blue {
  color: #00288E !important;
}

.color-red {
  color: #DC2626 !important;
}

/* 五险一金明细表 */
.social-table {
  display: flex;
  flex-direction: column;
}

.social-row {
  display: flex;
  align-items: center;
  padding: 20rpx 12rpx;
  border-bottom: 1rpx solid #F1F5F9;
  font-size: 24rpx;
}

.social-head {
  background-color: #F8FAFC;
  color: #64748B;
  font-weight: 600;
  border-radius: 12rpx;
}

.social-foot {
  background-color: #EFF4FF;
  border-radius: 12rpx;
  margin-top: 16rpx;
  border-bottom: none;
}

.s-col {
  color: #334155;
}

.flex-2 { flex: 2; }
.flex-1 { flex: 1; }
.text-center { text-align: center; }

/* 专项附加扣除列表 */
.special-drawer-scroll {
  max-height: 50vh;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.special-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F1F5F9;
}

.item-text {
  display: flex;
  flex-direction: column;
}

.item-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #1E293B;
}

.item-desc {
  font-size: 22rpx;
  color: #64748B;
  margin-top: 4rpx;
}

.stepper {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background-color: #F1F5F9;
  border-radius: 100rpx;
  padding: 6rpx 12rpx;
}

.step-btn {
  width: 48rpx;
  height: 48rpx;
  background-color: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  color: #00288E;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.08);
}

.step-num {
  font-size: 24rpx;
  font-weight: 700;
  color: #1E293B;
  min-width: 60rpx;
  text-align: center;
}

.toggle-chips {
  display: flex;
  gap: 12rpx;
}

.drawer-btn-wrap {
  margin-top: 24rpx;
}

.btn-confirm {
  height: 84rpx;
  background-color: #00288E;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 辅助工具弹窗内容 */
.tool-content {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.tool-input-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.tool-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #334155;
}

.tool-input-wrap {
  display: flex;
  align-items: center;
  background: #F1F5F9;
  border-radius: 12rpx;
  padding: 10rpx 20rpx;
  width: 180rpx;
}

.tool-input {
  flex: 1;
  font-size: 30rpx;
  font-weight: 700;
  color: #00288E;
  text-align: right;
}

.tool-unit {
  font-size: 24rpx;
  color: #64748B;
  margin-left: 8rpx;
}

.tool-result-box {
  background: linear-gradient(135deg, #F8FAFC 0%, #EFF4FF 100%);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-top: 10rpx;
  border: 1rpx solid #DCE9FF;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.r-label {
  font-size: 24rpx;
  color: #64748B;
}

.r-val {
  font-size: 52rpx;
  font-weight: 800;
  margin: 10rpx 0;
}

.r-tip {
  font-size: 22rpx;
  color: #94A3B8;
}

.r-detail-row {
  display: flex;
  gap: 24rpx;
  font-size: 22rpx;
  color: #475569;
  margin-top: 8rpx;
}

/* ==================== 购车用车专属样式 ==================== */
.loan-configs {
  border-top: 1rpx dashed #E2E8F0;
  padding-top: 24rpx;
  margin-top: 24rpx;
}

.dual-inputs-row {
  display: flex;
  gap: 20rpx;
  margin-top: 16rpx;
}

.half-input-col {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.sub-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #475569;
  margin-bottom: 10rpx;
}

.small-input-wrap {
  display: flex;
  align-items: center;
  background: #F8FAFC;
  border-radius: 14rpx;
  padding: 12rpx 20rpx;
  border: 1rpx solid #E2E8F0;
}

.small-input {
  flex: 1;
  font-size: 32rpx;
  font-weight: 700;
  color: #00288E;
  height: 50rpx;
}

/* 4S 店陷阱警告横幅 */
.blind-warning-card {
  background: linear-gradient(135deg, #FEF2F2 0%, #FFF5F5 100%);
  border: 2rpx solid #FCA5A5;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.blind-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.blind-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #B91C1C;
}

.blind-desc {
  font-size: 22rpx;
  color: #7F1D1D;
  line-height: 1.5;
  display: block;
}

/* 对照拆解表卡片 */
.table-card {
  background-color: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--border-color);
}

.table-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.table-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1E293B;
}

.table-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F1F5F9;
  font-size: 24rpx;
}

.table-head-row {
  background-color: #F8FAFC;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  color: #64748B;
}

.col-item {
  color: #334155;
}

/* 省钱大看板 (油电对比) */
.highlight-banner {
  background: linear-gradient(135deg, #059669 0%, #10B981 100%);
  border-radius: 32rpx;
  padding: 36rpx 32rpx;
  color: #FFFFFF;
  margin-bottom: 24rpx;
}

.banner-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}

.badge-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255, 255, 255, 0.95);
  padding: 6rpx 16rpx;
  border-radius: 100rpx;
}

.badge-text {
  font-size: 22rpx;
  font-weight: 700;
  color: #059669;
}

.banner-date {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

.save-title {
  font-size: 28rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.95);
}

.save-amount {
  display: flex;
  align-items: baseline;
  margin: 8rpx 0 16rpx 0;
}

.save-amount .symbol {
  font-size: 40rpx;
  font-weight: 600;
  margin-right: 8rpx;
}

.save-amount .num {
  font-size: 68rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
  line-height: 1;
}

.save-amount .unit {
  font-size: 38rpx;
  font-weight: 600;
}

.banner-tip {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.88);
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
  padding-top: 16rpx;
  line-height: 1.4;
}

/* 油电双栏对比卡片 */
.compare-cards {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.scheme-card {
  background-color: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx;
  border: 2rpx solid transparent;
}

.scheme-recommend {
  border-color: rgba(5, 150, 105, 0.3);
  background: linear-gradient(180deg, #F0FDF4 0%, #FFFFFF 30%);
}

.scheme-normal {
  border-color: #E2E8F0;
}

.scheme-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.scheme-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.scheme-tag {
  background-color: #059669;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.scheme-tag.tag-gray {
  background-color: #64748B;
}

.scheme-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1E293B;
}

.tax-total {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 16rpx 0;
  border-bottom: 1rpx dashed #E2E8F0;
  margin-bottom: 16rpx;
}

.tax-total .label {
  font-size: 24rpx;
  color: #64748B;
}

.tax-total .val {
  font-size: 36rpx;
  font-weight: 800;
}

.scheme-details {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.s-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.s-name {
  font-size: 24rpx;
  color: #64748B;
}

.s-val {
  font-size: 24rpx;
  color: #1E293B;
}

.animate-fade-in {
  animation: fadeIn 0.25s ease-in-out;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(-8rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ================= 通用辅助类 ================= */
.text-right {
  text-align: right;
}

.text-center {
  text-align: center;
}

.flex-1 {
  flex: 1;
}

.flex-2 {
  flex: 2;
}

.flex-3 {
  flex: 3;
}

/* ================= 通用辅助样式 ================= */
.picker-display {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #F8F9FD;
  border: 1rpx solid var(--border-color);
  border-radius: 16rpx;
  padding: 24rpx;
}

.picker-value {
  font-size: 30rpx;
  color: var(--text-main);
}

.month-scroll {
  width: 100%;
  white-space: nowrap;
}

.month-chips {
  display: flex;
  gap: 12rpx;
  padding: 8rpx 0;
}

.month-chip {
  flex-shrink: 0;
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  border-radius: 30rpx;
  background: #F1F5FD;
  color: var(--text-regular);
  transition: all 0.2s;
}

.month-chip.month-chip-active {
  background: var(--primary-color);
  color: #FFFFFF;
  font-weight: 700;
}

