/** pages/result/result.wxss **/

.result-container {
  min-height: 100vh;
  background-color: var(--bg-color);
  padding-bottom: 40rpx;
  box-sizing: border-box;
}

.custom-navbar {
  --td-navbar-bg-color: #FFFFFF !important;
  --td-navbar-color: var(--text-main) !important;
}

.content-body {
  padding: 24rpx 32rpx;
}

/* 1. 核心看板 (Hero Card) */
.hero-card {
  background: linear-gradient(135deg, #00288E 0%, #0045B8 60%, #0051D5 100%);
  border-radius: 32rpx;
  padding: 36rpx 32rpx;
  color: #FFFFFF;
  margin-bottom: 24rpx;
}

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.hero-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 500;
}

.hero-amount {
  display: flex;
  align-items: baseline;
  margin-bottom: 16rpx;
}

.hero-amount .currency {
  font-size: 38rpx;
  font-weight: 600;
  margin-right: 8rpx;
}

.hero-amount .number {
  font-size: 64rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1.1;
}

.hero-amount .cents {
  font-size: 38rpx;
  font-weight: 600;
}

.hero-foot {
  border-top: 1rpx solid rgba(255, 255, 255, 0.15);
  padding-top: 16rpx;
}

.foot-tip {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 2. 三列核心数据速览 */
.metric-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.metric-card {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 20rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  border: 1rpx solid rgba(220, 233, 255, 0.6);
}

.metric-label {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-bottom: 8rpx;
}

.metric-val {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-main);
}

.color-amber { color: #D97706 !important; }
.color-blue { color: #0051D5 !important; }

.metric-sub {
  font-size: 20rpx;
  color: var(--text-light);
  margin-top: 6rpx;
}

/* 3. 通用 section-card */
.section-card {
  background-color: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx 28rpx 16rpx 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(220, 233, 255, 0.6);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.card-header .header-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-main);
}

.header-right-text {
  font-size: 24rpx;
  color: var(--text-muted);
}

.header-right-tag {
  font-size: 24rpx;
  color: #059669;
  font-weight: 600;
  background-color: #ECFDF5;
  padding: 4rpx 16rpx;
  border-radius: 100rpx;
}

/* 进度条明细 */
.progress-item {
  margin-bottom: 24rpx;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.progress-info .p-name {
  color: var(--text-regular);
}

.progress-info .p-amount {
  font-weight: 600;
  color: var(--text-main);
}

/* 折叠面板内容明细行 */
.detail-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 24rpx;
  border-bottom: 1rpx solid #F1F5FD;
}

.detail-row .detail-name {
  color: var(--text-regular);
}

.detail-row .detail-val {
  font-weight: 600;
  color: var(--text-main);
}

.total-highlight {
  border-bottom: none;
  background-color: #EFF4FF;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  margin-top: 8rpx;
}

.total-highlight .detail-name {
  color: #00288E;
  font-weight: 600;
}

.total-highlight .detail-val {
  color: #00288E;
  font-weight: 700;
}

/* 专项扣除 Chips */
.deduct-tags {
  display: flex;
  gap: 16rpx;
  padding-bottom: 12rpx;
}

.deduct-chip {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #F8FAFC;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  border: 1rpx solid #E2E8F0;
}

.deduct-chip .chip-label {
  font-size: 24rpx;
  color: var(--text-main);
  font-weight: 500;
}

.deduct-chip .chip-val {
  font-size: 24rpx;
  color: #059669;
  font-weight: 700;
}

/* 底部操作栏 */
.bottom-bar-placeholder {
  height: 140rpx;
}

.bottom-action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #FFFFFF;
  padding: 20rpx 32rpx;
  display: flex;
  gap: 20rpx;
  border-top: 1rpx solid #E2E8F0;
  box-shadow: 0 -4rpx 16rpx rgba(11, 28, 48, 0.05);
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  z-index: 100;
}

.action-btn-secondary {
  flex: 1;
  height: 88rpx;
  background-color: #EFF4FF;
  border: 1rpx solid #DCE9FF;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.action-btn-secondary .btn-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #00288E;
}

.action-btn-primary {
  flex: 2;
  height: 88rpx;
  background: linear-gradient(135deg, #00288E 0%, #0051D5 100%);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: 0 4rpx 14rpx rgba(0, 40, 142, 0.25);
}

.action-btn-primary .btn-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}
