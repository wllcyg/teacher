<view class="result-page">
  <!-- 顶部沉浸式导航栏 -->
  <t-navbar
    title="{{type === 'salary' ? '薪资个税终端' : (type === 'car' ? '购车用车终端' : '房贷测算终端')}}"
    left-arrow
    delta="{{0}}"
    fixed
    placeholder
    bind:go-back="onBack"
    t-class="custom-navbar"
  />

  <!-- ==================== A. 房贷测算模式 ==================== -->
  <view wx:if="{{type === 'mortgage'}}" class="page-body">
    <!-- 1. 顶部贷款类型切换 Segmented Tabs -->
    <view class="segmented-control card-shadow">
      <view
        class="segment-btn {{loanType === 'commercial' ? 'active' : ''}}"
        hover-class="touch-active"
        bindtap="onLoanTypeChange"
        data-type="commercial"
      >
        商业贷款
      </view>
      <view
        class="segment-btn {{loanType === 'fund' ? 'active' : ''}}"
        hover-class="touch-active"
        bindtap="onLoanTypeChange"
        data-type="fund"
      >
        公积金贷款
      </view>
      <view
        class="segment-btn {{loanType === 'combination' ? 'active' : ''}}"
        hover-class="touch-active"
        bindtap="onLoanTypeChange"
        data-type="combination"
      >
        组合贷款
      </view>
    </view>

    <!-- 2. 核心参数输入表单卡片 -->
    <view class="form-card card-shadow">
      <!-- 商贷金额 (商业贷或组合贷模式) -->
      <view wx:if="{{loanType !== 'fund'}}" class="form-item">
        <view class="item-header">
          <text class="item-label">商业贷款金额</text>
          <text class="item-unit">单位：万元</text>
        </view>
        <view class="input-wrap">
          <input
            class="amount-input"
            type="digit"
            confirm-type="done"
            value="{{commercialAmount}}"
            bindinput="onCommAmountInput"
            bindconfirm="onConfirmInput"
            bindblur="onBlurInput"
            placeholder="0"
          />
          <text class="unit-text">万</text>
        </view>
      </view>

      <!-- 公积金金额 (公积金贷或组合贷模式) -->
      <view wx:if="{{loanType !== 'commercial'}}" class="form-item">
        <view class="item-header">
          <text class="item-label">公积金贷款金额</text>
          <text class="item-unit">单位：万元</text>
        </view>
        <view class="input-wrap">
          <input
            class="amount-input"
            type="digit"
            confirm-type="done"
            value="{{fundAmount}}"
            bindinput="onFundAmountInput"
            bindconfirm="onConfirmInput"
            bindblur="onBlurInput"
            placeholder="0"
          />
          <text class="unit-text">万</text>
        </view>
      </view>

      <!-- 贷款年限 -->
      <view class="form-item">
        <view class="item-header">
          <text class="item-label">按揭贷款年限</text>
          <text class="item-unit">期数：{{years * 12}} 期</text>
        </view>
        <view class="year-chips">
          <view
            class="chip {{years === 10 ? 'chip-active' : ''}}"
            hover-class="touch-active"
            bindtap="selectYears"
            data-years="10"
          >
            10年(120期)
          </view>
          <view
            class="chip {{years === 20 ? 'chip-active' : ''}}"
            hover-class="touch-active"
            bindtap="selectYears"
            data-years="20"
          >
            20年(240期)
          </view>
          <view
            class="chip {{years === 30 ? 'chip-active' : ''}}"
            hover-class="touch-active"
            bindtap="selectYears"
            data-years="30"
          >
            30年(360期)
          </view>
        </view>
      </view>

      <!-- 商贷利率 -->
      <view wx:if="{{loanType !== 'fund'}}" class="form-item">
        <view class="item-header">
          <text class="item-label">商贷执行利率 (LPR基准)</text>
          <text class="item-action" bindtap="fillLatestLPR">最新基准 {{latestLprRate}}%</text>
        </view>
        <view class="input-wrap">
          <input
            class="amount-input"
            type="digit"
            confirm-type="done"
            value="{{commercialRate}}"
            bindinput="onCommRateInput"
            bindconfirm="onConfirmInput"
            bindblur="onBlurInput"
            placeholder="3.10"
          />
          <text class="unit-text">%</text>
        </view>
      </view>

      <!-- 还款方式 -->
      <view class="form-item">
        <view class="item-header">
          <text class="item-label">还款计算方式</text>
        </view>
        <view class="type-segmented">
          <view
            class="type-btn {{repaymentType === 'equal_installment' ? 'type-active' : ''}}"
            hover-class="touch-active"
            bindtap="onRepaymentTypeChange"
            data-type="equal_installment"
          >
            等额本息 (每月还款固定)
          </view>
          <view
            class="type-btn {{repaymentType === 'equal_principal' ? 'type-active' : ''}}"
            hover-class="touch-active"
            bindtap="onRepaymentTypeChange"
            data-type="equal_principal"
          >
            等额本金 (逐月递减)
          </view>
        </view>
      </view>
    </view>

    <!-- 3. 房贷结果看板 -->
    <view wx:if="{{mortgageResult}}" class="result-dashboard card-shadow-lg">
      <view class="dash-header">
        <text class="dash-subtitle">
          {{mortgageResult.repaymentType === 'equal_installment' ? '等额本息 · 每月固定还款' : '等额本金 · 首月还款最高'}}
        </text>
        <t-tag size="small" theme="primary" variant="light">精准测算</t-tag>
      </view>

      <view class="dash-main-amount">
        <text class="amount-symbol">¥</text>
        <text class="amount-integer">{{mortgageResult.monthlyPaymentFirst}}</text>
        <text class="amount-unit">/月</text>
      </view>

      <view wx:if="{{mortgageResult.repaymentType === 'equal_principal'}}" class="dash-sub-decrease">
        <text>每月递减约 ¥{{mortgageResult.monthlyPaymentDecrease}} 元 · 末月月供约 ¥{{mortgageResult.monthlyPaymentLast}} 元</text>
      </view>

      <view class="dash-ratio-bar">
        <view class="bar-track">
          <view class="bar-fill-blue" style="width: {{mortgageResult.principalPercent}}%"></view>
          <view class="bar-fill-amber" style="width: {{mortgageResult.interestPercent}}%"></view>
        </view>
        <view class="ratio-labels">
          <view class="label-item">
            <view class="dot dot-blue"></view>
            <text class="ratio-txt">贷款本金: {{mortgageResult.totalPrincipalWan}}万 ({{mortgageResult.principalPercent}}%)</text>
          </view>
          <view class="label-item">
            <view class="dot dot-amber"></view>
            <text class="ratio-txt">利息总额: {{mortgageResult.totalInterestWan}}万 ({{mortgageResult.interestPercent}}%)</text>
          </view>
        </view>
      </view>

      <view class="dash-stats-grid">
        <view class="stat-col">
          <text class="stat-label">还款总额</text>
          <text class="stat-val">¥{{mortgageResult.totalRepaymentWan}}<text class="stat-unit">万</text></text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-col">
          <text class="stat-label">累计利息</text>
          <text class="stat-val highlight-amber">¥{{mortgageResult.totalInterestWan}}<text class="stat-unit">万</text></text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-col">
          <text class="stat-label">按揭期数</text>
          <text class="stat-val">{{mortgageResult.totalMonths}}<text class="stat-unit">期</text></text>
        </view>
      </view>
    </view>

    <!-- 4. 房贷快捷入口 -->
    <view class="action-card-group">
      <view class="action-entry card-shadow" hover-class="touch-active" bindtap="toggleSchedulePopup">
        <view class="entry-left">
          <t-icon name="view-list" size="40rpx" color="#00288E" />
          <view class="entry-texts">
            <text class="entry-title">查看 {{mortgageResult.totalMonths}} 期逐月还款明细表</text>
            <text class="entry-sub">本金、利息与剩余本金全量账单</text>
          </view>
        </view>
        <t-icon name="chevron-right" size="36rpx" color="#94A3B8" />
      </view>
    </view>
  </view>

  <!-- ==================== B. 工资个税测算模式 ==================== -->
  <view wx:if="{{type === 'salary'}}" class="page-body">
    <!-- 1. 顶部模式切换 (正算 / 倒推) -->
    <view class="segmented-control card-shadow">
      <view
        class="segment-btn {{salaryMode === 'forward' ? 'active' : ''}}"
        hover-class="touch-active"
        bindtap="onSalaryModeChange"
        data-mode="forward"
      >
        税前算税后 (累计预扣)
      </view>
      <view
        class="segment-btn {{salaryMode === 'reverse' ? 'active' : ''}}"
        hover-class="touch-active"
        bindtap="onSalaryModeChange"
        data-mode="reverse"
      >
        税后倒推税前 (精准反解)
      </view>
    </view>

    <!-- 2. 核心输入卡片 -->
    <view class="form-card card-shadow">
      <!-- 城市选择横滑 -->
      <view class="form-item">
        <view class="item-header">
          <text class="item-label">参保城市 (自动匹配社保基数与比例)</text>
        </view>
        <scroll-view class="city-scroll no-scrollbar" scroll-x enable-flex>
          <view class="city-chips">
            <view
              wx:for="{{cityList}}"
              wx:key="key"
              class="city-chip {{selectedCityKey === item.key ? 'city-chip-active' : ''}}"
              hover-class="touch-active"
              bindtap="selectCity"
              data-key="{{item.key}}"
            >
              {{item.name}}
            </view>
          </view>
        </scroll-view>
      </view>

      <!-- 正算法: 输入税前月薪 -->
      <view wx:if="{{salaryMode === 'forward'}}" class="form-item">
        <view class="item-header">
          <text class="item-label">税前月薪金额</text>
          <text class="item-unit">单位：元/月</text>
        </view>
        <view class="input-wrap">
          <input
            class="amount-input"
            type="digit"
            value="{{preTaxSalary}}"
            bindinput="onPreTaxSalaryInput"
            bindconfirm="onConfirmInput"
            bindblur="onBlurInput"
            placeholder="0"
          />
          <text class="unit-text">元</text>
        </view>
        <view class="quick-presets">
          <view
            wx:for="{{[10000, 15000, 20000, 30000, 50000]}}"
            wx:key="*this"
            class="chip {{preTaxSalary === item ? 'chip-active' : ''}}"
            hover-class="touch-active"
            bindtap="selectSalaryPreset"
            data-val="{{item}}"
          >
            {{item / 1000}}k
          </view>
        </view>
      </view>

      <!-- 倒推法: 输入期望税后到手月薪 -->
      <view wx:if="{{salaryMode === 'reverse'}}" class="form-item">
        <view class="item-header">
          <text class="item-label">期望税后到手月薪</text>
          <text class="item-unit">单位：元/月</text>
        </view>
        <view class="input-wrap">
          <input
            class="amount-input"
            type="digit"
            value="{{targetNetSalary}}"
            bindinput="onTargetNetInput"
            bindconfirm="onConfirmInput"
            bindblur="onBlurInput"
            placeholder="0"
          />
          <text class="unit-text">元</text>
        </view>
      </view>

      <!-- 五险一金 & 专项附加扣除 设置入口条 -->
      <view class="config-entries">
        <view class="config-bar" hover-class="touch-active" bindtap="toggleSocialDetailPopup">
          <view class="bar-left">
            <t-icon name="secured" size="36rpx" color="#00288E" />
            <view class="bar-info">
              <text class="bar-title">五险一金配置 ({{salaryResult.cityName}})</text>
              <text class="bar-sub">个人缴纳 ¥{{salaryResult.socialRes.personal.formatTotal}} · 单位承担 ¥{{salaryResult.socialRes.company.formatTotal}}</text>
            </view>
          </view>
          <t-icon name="chevron-right" size="32rpx" color="#94A3B8" />
        </view>

        <view class="config-bar" hover-class="touch-active" bindtap="toggleSpecialDeductionPopup">
          <view class="bar-left">
            <t-icon name="view-module" size="36rpx" color="#059669" />
            <view class="bar-info">
              <text class="bar-title">7大专项附加扣除</text>
              <text class="bar-sub">当前已抵扣 ¥{{specialDeductionSummary.monthlyTotal}}元/月</text>
            </view>
          </view>
          <t-icon name="chevron-right" size="32rpx" color="#94A3B8" />
        </view>
      </view>
    </view>

    <!-- 3. 工资个税结果看板 -->
    <view wx:if="{{salaryMode === 'forward' && salaryResult}}" class="result-dashboard card-shadow-lg">
      <view class="dash-header">
        <text class="dash-subtitle">首月实发工资 (税后到手)</text>
        <t-tag size="small" theme="success" variant="light">累计预扣算法</t-tag>
      </view>

      <view class="dash-main-amount">
        <text class="amount-symbol">¥</text>
        <text class="amount-integer">{{salaryResult.firstMonth.formatNetSalary}}</text>
        <text class="amount-unit">/月</text>
      </view>

      <view class="dash-sub-decrease">
        <text>首月扣税 ¥{{salaryResult.firstMonth.formatTax}} ({{salaryResult.firstMonth.taxRate}}%) · 五险一金 ¥{{salaryResult.socialRes.personal.formatTotal}}</text>
      </view>

      <view class="dash-stats-grid">
        <view class="stat-col">
          <text class="stat-label">全年税后总计</text>
          <text class="stat-val">¥{{salaryResult.annualSummary.formatTotalAnnualNet}}</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-col">
          <text class="stat-label">全年应缴个税</text>
          <text class="stat-val highlight-amber">¥{{salaryResult.annualSummary.formatTotalAnnualTax}}</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-col">
          <text class="stat-label">企业用工成本</text>
          <text class="stat-val">¥{{salaryResult.annualSummary.formatTotalAnnualCompanyCost}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{salaryMode === 'reverse' && reverseResult}}" class="result-dashboard card-shadow-lg">
      <view class="dash-header">
        <text class="dash-subtitle">反解税前应发月薪建议</text>
        <t-tag size="small" theme="primary" variant="light">二分法数值迭代</t-tag>
      </view>

      <view class="dash-main-amount">
        <text class="amount-symbol">¥</text>
        <text class="amount-integer">{{reverseResult.formatPreTaxSalary}}</text>
        <text class="amount-unit">/月</text>
      </view>

      <view class="dash-sub-decrease">
        <text>期望税后 ¥{{reverseResult.formatTargetNet}} · 首月实发 ¥{{reverseResult.detail.firstMonth.formatNetSalary}}</text>
      </view>

      <view class="dash-stats-grid">
        <view class="stat-col">
          <text class="stat-label">预估个税</text>
          <text class="stat-val highlight-amber">¥{{reverseResult.detail.firstMonth.formatTax}}</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-col">
          <text class="stat-label">五险一金扣除</text>
          <text class="stat-val">¥{{reverseResult.detail.socialRes.personal.formatTotal}}</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-col">
          <text class="stat-label">单位总成本</text>
          <text class="stat-val">¥{{reverseResult.detail.annualSummary.formatTotalAnnualCompanyCost}}</text>
        </view>
      </view>
    </view>

    <!-- 4. 工资个税增值入口 -->
    <view class="action-card-group">
      <view class="action-entry card-shadow" hover-class="touch-active" bindtap="toggleSalarySchedulePopup">
        <view class="entry-left">
          <t-icon name="chart-bubble" size="40rpx" color="#00288E" />
          <view class="entry-texts">
            <text class="entry-title">查看 1~12 月逐月预扣明细 (跳档推演)</text>
            <text class="entry-sub">洞察下半年个税跳档及各月实际到手波动</text>
          </view>
        </view>
        <t-icon name="chevron-right" size="36rpx" color="#94A3B8" />
      </view>

      <view class="action-entry card-shadow" hover-class="touch-active" bindtap="goToCompare">
        <view class="entry-left">
          <t-icon name="swap" size="40rpx" color="#059669" />
          <view class="entry-texts">
            <text class="entry-title">年终奖单独计税 vs 合并计税筹划</text>
            <text class="entry-sub">测算年终奖避税临界点与最优发放建议</text>
          </view>
        </view>
        <t-icon name="chevron-right" size="36rpx" color="#94A3B8" />
      </view>

      <view class="sub-tools-row">
        <view class="sub-tool-card card-shadow" hover-class="touch-active" bindtap="openSubTool" data-tool="overtime">
          <t-icon name="time" size="36rpx" color="#D97706" />
          <text class="tool-title">加班费计算器</text>
          <text class="tool-sub">工作日/周末/法定节假日</text>
        </view>
        <view class="sub-tool-card card-shadow" hover-class="touch-active" bindtap="openSubTool" data-tool="severance">
          <t-icon name="user" size="36rpx" color="#7C3AED" />
          <text class="tool-title">离职补偿金 N+1</text>
          <text class="tool-sub">3倍社平免税合规测算</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ==================== C. 购车用车测算模式 ==================== -->
  <view wx:if="{{type === 'car'}}" class="page-body">
    <!-- 1. 顶部模式切换 (全包落地与车贷 / 油电成本对比) -->
    <view class="segmented-control card-shadow">
      <view
        class="segment-btn {{carTab === 'landing' ? 'active' : ''}}"
        hover-class="touch-active"
        bindtap="onCarTabChange"
        data-tab="landing"
      >
        落地总价与车贷分期
      </view>
      <view
        class="segment-btn {{carTab === 'running' ? 'active' : ''}}"
        hover-class="touch-active"
        bindtap="onCarTabChange"
        data-tab="running"
      >
        油车 vs 电车成本对比
      </view>
    </view>

    <!-- 2. Tab 1: 全包落地价与车贷分期 -->
    <view wx:if="{{carTab === 'landing'}}">
      <view class="form-card card-shadow">
        <!-- 动力类型 -->
        <view class="form-item">
          <view class="item-header">
            <text class="item-label">车辆动力类型 (影响购置税与车船税)</text>
          </view>
          <view class="type-segmented">
            <view
              class="type-btn {{carPowerType === 'fuel' ? 'type-active' : ''}}"
              hover-class="touch-active"
              bindtap="onPowerTypeChange"
              data-power="fuel"
            >
              燃油车
            </view>
            <view
              class="type-btn {{carPowerType === 'electric' ? 'type-active' : ''}}"
              hover-class="touch-active"
              bindtap="onPowerTypeChange"
              data-power="electric"
            >
              纯电动 (免税)
            </view>
            <view
              class="type-btn {{carPowerType === 'phev' ? 'type-active' : ''}}"
              hover-class="touch-active"
              bindtap="onPowerTypeChange"
              data-power="phev"
            >
              插混 / 增程
            </view>
          </view>
        </view>

        <!-- 裸车价格输入 -->
        <view class="form-item">
          <view class="item-header">
            <text class="item-label">裸车成交价</text>
            <text class="item-unit">折合 ¥{{landingResult.formatCarPrice}} 元</text>
          </view>
          <view class="input-wrap">
            <input
              class="amount-input"
              type="digit"
              value="{{carPriceWan}}"
              bindinput="onCarPriceInput"
              bindconfirm="onConfirmInput"
              bindblur="onBlurInput"
              placeholder="15"
            />
            <text class="unit-text">万元</text>
          </view>
          <!-- 快捷预设 -->
          <view class="quick-presets">
            <view
              wx:for="{{[10, 15, 25, 35, 50]}}"
              wx:key="*this"
              class="chip {{carPriceWan === item ? 'chip-active' : ''}}"
              hover-class="touch-active"
              bindtap="selectCarPricePreset"
              data-val="{{item}}"
            >
              {{item}}万
            </view>
          </view>
        </view>

        <!-- 购车方式切换 (全款 / 分期) -->
        <view class="form-item item-border-top">
          <view class="item-header">
            <text class="item-label">购车付款方式</text>
          </view>
          <view class="type-segmented">
            <view
              class="type-btn {{buyWay === 'loan' ? 'type-active' : ''}}"
              hover-class="touch-active"
              bindtap="onBuyWayChange"
              data-way="loan"
            >
              贷款分期 (含IRR反解)
            </view>
            <view
              class="type-btn {{buyWay === 'full' ? 'type-active' : ''}}"
              hover-class="touch-active"
              bindtap="onBuyWayChange"
              data-way="full"
            >
              全款一次性支付
            </view>
          </view>
        </view>

        <!-- 贷款分期专用参数 -->
        <view wx:if="{{buyWay === 'loan'}}" class="loan-configs animate-fade-in">
          <!-- 首付比例 -->
          <view class="form-item">
            <view class="item-header">
              <text class="item-label">首付比例</text>
              <text class="item-value-text">首付 ¥{{carLoanResult.formatDownPaymentAmount}} 元</text>
            </view>
            <view class="year-chips">
              <view
                class="chip {{downPaymentRatio === 0.2 ? 'chip-active' : ''}}"
                hover-class="touch-active"
                bindtap="selectDownPaymentRatio"
                data-ratio="0.2"
              >
                首付20%
              </view>
              <view
                class="chip {{downPaymentRatio === 0.3 ? 'chip-active' : ''}}"
                hover-class="touch-active"
                bindtap="selectDownPaymentRatio"
                data-ratio="0.3"
              >
                首付30%
              </view>
              <view
                class="chip {{downPaymentRatio === 0.5 ? 'chip-active' : ''}}"
                hover-class="touch-active"
                bindtap="selectDownPaymentRatio"
                data-ratio="0.5"
              >
                首付50%
              </view>
            </view>
          </view>

          <!-- 分期月数 -->
          <view class="form-item">
            <view class="item-header">
              <text class="item-label">分期期限</text>
              <text class="item-value-text">贷款 ¥{{carLoanResult.formatLoanPrincipal}} 元</text>
            </view>
            <view class="year-chips">
              <view
                wx:for="{{[12, 24, 36, 60]}}"
                wx:key="*this"
                class="chip {{carLoanMonths === item ? 'chip-active' : ''}}"
                hover-class="touch-active"
                bindtap="selectCarLoanMonths"
                data-months="{{item}}"
