            </view>
          </view>
          <t-icon name="chevron-right" size="36rpx" color="#94A3B8" />
        </view>

        <view class="action-entry card-shadow" hover-class="touch-active" bindtap="toggleDepreciationPopup">
          <view class="entry-left">
            <t-icon name="chart-bar" size="40rpx" color="#059669" />
            <view class="entry-texts">
              <text class="entry-title">二手车估值与 1~8 年保值率折旧曲线</text>
              <text class="entry-sub">推演各车龄预估残值与保值梯队</text>
            </view>
          </view>
          <t-icon name="chevron-right" size="36rpx" color="#94A3B8" />
        </view>
      </view>
    </view>

    <!-- 3. Tab 2: 油车 vs 电车全周期养车成本对比 -->
    <view wx:if="{{carTab === 'running'}}">
      <view class="form-card card-shadow">
        <view class="form-item">
          <view class="item-header">
            <text class="item-label">预估年行驶里程</text>
            <text class="item-value-text">{{annualMileage}} 公里/年</text>
