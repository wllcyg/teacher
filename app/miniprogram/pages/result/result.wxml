    </view>
  </view>

  <!-- ==================== 弹窗区 ==================== -->

  <!-- 1. 房贷 360 期逐月还款明细半屏抽屉 -->
  <t-popup visible="{{showSchedulePopup}}" placement="bottom" bind:visible-change="toggleSchedulePopup">
    <view class="schedule-drawer">
      <view class="drawer-header">
        <view class="drawer-title-group">
          <text class="drawer-title">{{mortgageResult.years}}年全周期还款计划表</text>
          <text class="drawer-sub">严格执行银行级本息平账校验</text>
        </view>
        <view class="drawer-close" bindtap="toggleSchedulePopup">
          <t-icon name="close" size="40rpx" color="#64748B" />
        </view>
      </view>

      <view class="schedule-thead">
        <text class="th th-month">期数</text>
        <text class="th th-pay">月供(元)</text>
        <text class="th th-prin">偿还本金</text>
        <text class="th th-inte">偿还利息</text>
        <text class="th th-rest">剩余本金</text>
      </view>

      <scroll-view class="schedule-scroll" scroll-y enable-flex>
        <view wx:for="{{mortgageResult.schedule}}" wx:key="month" class="schedule-row {{item.month % 12 === 0 ? 'row-year-end' : ''}}">
