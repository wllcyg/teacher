            />
            <text class="unit-text">公里/年</text>
          </view>
          <view class="quick-presets">
            <view
              wx:for="{{[10000, 15000, 20000, 30000]}}"
              wx:key="*this"
              class="chip {{annualMileage === item ? 'chip-active' : ''}}"
              hover-class="touch-active"
              bindtap="onAnnualMileageInput"
              data-value="{{item}}"
            >
              {{item / 10000}}万公里
            </view>
          </view>
        </view>
      </view>

      <!-- 省钱大看板 -->
      <view class="highlight-banner card-shadow-lg">
        <view class="banner-top">
          <view class="badge-tag">
            <t-icon name="check-circle" size="28rpx" color="#059669" />
            <text class="badge-text">电车养车省钱推演</text>
          </view>
          <text class="banner-date">按年跑 {{annualMileage}} 公里测算</text>
        </view>
        <view class="banner-main">
          <text class="save-title">电车每年综合可省支出</text>
          <view class="save-amount">
            <text class="symbol">¥</text>
            <text class="num">{{runningCostResult.formatAnnualTotalSaved}}</text>
            <text class="unit">/年</text>
          </view>
        </view>
        <view class="banner-tip">
          <text>5年累计省下 ¥{{runningCostResult.formatSave5Years}} 元 · {{runningCostResult.breakevenDesc}}</text>
        </view>
      </view>

      <!-- 油车 vs 电车 双栏并排对比卡片 -->
      <view class="compare-cards">
        <!-- 燃油车卡片 -->
        <view class="scheme-card scheme-normal card-shadow">
          <view class="scheme-header">
            <view class="scheme-title-wrap">
              <text class="scheme-tag tag-gray">传统燃油车</text>
              <text class="scheme-name">综合油耗 7.5L/100km</text>
            </view>
            <t-tag theme="default" variant="light" size="small">92#汽油</t-tag>
          </view>
          <view class="tax-total">
            <text class="label">年度总养车成本</text>
            <text class="val color-red">¥ {{runningCostResult.fuelCar.formatTotalAnnualCost}}</text>
          </view>
          <view class="scheme-details">
            <view class="s-row">
              <text class="s-name">年度燃油能耗费</text>
              <text class="s-val">¥ {{runningCostResult.fuelCar.formatEnergyCost}}</text>
            </view>
            <view class="s-row">
              <text class="s-name">年度常规保养</text>
              <text class="s-val">¥ {{runningCostResult.fuelCar.maintenanceCost}}</text>
            </view>
            <view class="s-row">
              <text class="s-name">折合每公里费用</text>
              <text class="s-val font-bold">¥ {{runningCostResult.fuelCar.costPerKm}} 元/km</text>
            </view>
          </view>
        </view>

        <!-- 纯电动车卡片 -->
        <view class="scheme-card scheme-recommend card-shadow">
          <view class="scheme-header">
            <view class="scheme-title-wrap">
              <text class="scheme-tag">纯电动汽车</text>
              <text class="scheme-name">综合电耗 14.5kWh/100km</text>
            </view>
            <t-tag theme="success" variant="dark" size="small">极低能耗</t-tag>
          </view>
          <view class="tax-total">
            <text class="label">年度总养车成本</text>
            <text class="val color-green">¥ {{runningCostResult.electricCar.formatTotalAnnualCost}}</text>
          </view>
          <view class="scheme-details">
            <view class="s-row">
              <text class="s-name">年度充电电费</text>
              <text class="s-val color-green">¥ {{runningCostResult.electricCar.formatEnergyCost}}</text>
            </view>
            <view class="s-row">
              <text class="s-name">年度常规保养</text>
              <text class="s-val">¥ {{runningCostResult.electricCar.maintenanceCost}}</text>
            </view>
            <view class="s-row">
              <text class="s-name">折合每公里费用</text>
              <text class="s-val font-bold color-green">¥ {{runningCostResult.electricCar.costPerKm}} 元/km</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- ==================== 底部固定操作栏 ==================== -->
  <view class="bottom-bar">
    <button class="btn-share" open-type="share">
