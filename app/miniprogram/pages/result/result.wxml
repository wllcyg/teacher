          </t-tag>
          <t-tag wx:else size="small" theme="success" variant="light">一次结清</t-tag>
        </view>

        <!-- 大字号主金额 -->
        <view class="dash-main-amount">
          <text class="amount-symbol">¥</text>
          <text class="amount-integer">{{buyWay === 'loan' ? carLoanResult.formatMonthlyPayment : landingResult.formatTotalLandingPrice}}</text>
          <text class="amount-unit">{{buyWay === 'loan' ? '/月' : ''}}</text>
        </view>

        <view class="dash-sub-decrease">
          <text wx:if="{{buyWay === 'loan'}}">
            首付开支 ¥{{carLoanResult.formatDownPaymentAmount}} · 利息总计 ¥{{carLoanResult.formatTotalInterest}} · 4S服务费 ¥{{carLoanResult.formatFinanceServiceFee}}
          </text>
          <text wx:else>
            裸车 ¥{{landingResult.formatCarPrice}} · 购置税 ¥{{landingResult.formatPurchaseTax}} · 商业险 ¥{{landingResult.formatCommercialInsurance}}
          </text>
        </view>

        <!-- 汇总三列指标 -->
        <view class="dash-stats-grid">
          <view class="stat-col">
            <text class="stat-label">{{buyWay === 'loan' ? '分期总开支' : '不含税车价'}}</text>
            <text class="stat-val">¥{{buyWay === 'loan' ? carLoanResult.formatTotalCostWithFee : landingResult.priceExclVat}}</text>
          </view>
          <view class="stat-divider"></view>
          <view class="stat-col">
            <text class="stat-label">购置税{{carPowerType === 'electric' ? '(全免)' : ''}}</text>
            <text class="stat-val {{carPowerType === 'electric' ? 'color-green' : 'highlight-amber'}}">¥{{landingResult.formatPurchaseTax}}</text>
          </view>
          <view class="stat-divider"></view>
          <view class="stat-col">
            <text class="stat-label">{{buyWay === 'loan' ? '真实年化IRR' : '商业车险'}}</text>
            <text class="stat-val font-bold {{buyWay === 'loan' && carLoanResult.realAnnualIRR > nominalRate ? 'color-red' : ''}}">
              {{buyWay === 'loan' ? carLoanResult.realAnnualIRR + '%' : '¥' + landingResult.formatCommercialInsurance}}
            </text>
          </view>
        </view>
      </view>

      <!-- 落地费用逐项拆解明细表 -->
      <view class="table-card card-shadow">
        <view class="table-header">
          <t-icon name="view-list" size="36rpx" color="#00288E" />
          <text class="table-title">全包落地明细拆解清单</text>
        </view>

        <view class="table-row table-head-row">
          <text class="col-item flex-2">费用科目</text>
          <text class="col-item flex-1 text-center font-bold">金额 (元)</text>
