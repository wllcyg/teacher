        </view>

        <view class="table-row">
          <text class="col-item flex-2 font-bold">裸车成交价</text>
          <text class="col-item flex-1 text-center">¥{{landingResult.formatCarPrice}}</text>
          <text class="col-item flex-2 text-center text-muted">发票成交总价</text>
        </view>

        <view class="table-row">
          <text class="col-item flex-2">车辆购置税</text>
          <text class="col-item flex-1 text-center font-bold {{carPowerType === 'electric' ? 'color-green' : ''}}">¥{{landingResult.formatPurchaseTax}}</text>
          <text class="col-item flex-2 text-center text-muted">{{landingResult.purchaseTaxRes.policyDesc}}</text>
        </view>

        <view class="table-row">
          <text class="col-item flex-2">车船使用税</text>
          <text class="col-item flex-1 text-center">¥{{landingResult.formatVehicleTax}}</text>
          <text class="col-item flex-2 text-center text-muted">{{carPowerType === 'electric' ? '纯电免征' : carDisplacement + 'L排量阶梯'}}</text>
        </view>

        <view class="table-row">
          <text class="col-item flex-2">法定交强险</text>
          <text class="col-item flex-1 text-center">¥{{landingResult.formatCompulsoryInsurance}}</text>
          <text class="col-item flex-2 text-center text-muted">家用{{carSeatCount}}座标准</text>
        </view>

        <view class="table-row">
          <text class="col-item flex-2">商业险预估</text>
          <text class="col-item flex-1 text-center">¥{{landingResult.formatCommercialInsurance}}</text>
          <text class="col-item flex-2 text-center text-muted">车损+三者300万</text>
