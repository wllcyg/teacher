<view class="result-page">
  <!-- 顶部沉浸式导航栏 -->
  <t-navbar
    title="{{type === 'salary' ? '薪资个税终端' : (type === 'car' ? '购车用车终端' : (type === 'saving' ? '储蓄理财终端' : (type === 'insurance' ? '家庭保险终端' : (type === 'life' ? '生活日常终端' : '房贷测算终端'))))}}"
    left-arrow
    delta="{{0}}"
    fixed
    placeholder
    bind:go-back="onBack"
    t-class="custom-navbar"
  />

  <!-- 1. 房贷测算模块 -->
  <calc-mortgage wx:if="{{type === 'mortgage'}}" initial-options="{{initialOptions}}" />

  <!-- 2. 工资个税模块 -->
  <calc-salary wx:elif="{{type === 'salary'}}" initial-options="{{initialOptions}}" />

  <!-- 3. 购车用车模块 -->
  <calc-car wx:elif="{{type === 'car'}}" initial-options="{{initialOptions}}" />

  <!-- 4. 储蓄理财模块 -->
  <calc-saving wx:elif="{{type === 'saving'}}" initial-options="{{initialOptions}}" />

  <!-- 5. 保险测算模块 -->
  <calc-insurance wx:elif="{{type === 'insurance'}}" initial-options="{{initialOptions}}" />

  <!-- 6. 生活日常模块 -->
  <view wx:elif="{{type === 'life'}}" class="page-body">
    <!-- 顶部 4 大微场景切换 Segmented Tabs (统一采用系统主色激活态) -->
    <view class="segmented-control card-shadow">
      <view
        class="segment-btn {{lifeTab === 'job' ? 'active' : ''}}"
        hover-class="touch-active"
        bindtap="onLifeTabChange"
        data-tab="job"
      >
        职场民生
      </view>
      <view
        class="segment-btn {{lifeTab === 'renovation' ? 'active' : ''}}"
        hover-class="touch-active"
        bindtap="onLifeTabChange"
        data-tab="renovation"
      >
        装修建材
      </view>
      <view
        class="segment-btn {{lifeTab === 'living' ? 'active' : ''}}"
        hover-class="touch-active"
        bindtap="onLifeTabChange"
        data-tab="living"
      >
        公用生活
      </view>
      <view
        class="segment-btn {{lifeTab === 'health' ? 'active' : ''}}"
        hover-class="touch-active"
        bindtap="onLifeTabChange"
        data-tab="health"
      >
        健康仪式
      </view>
    </view>

    <!-- 子组件按需渲染 (高内聚、风格统一) -->
    <daily-job wx:if="{{lifeTab === 'job'}}" initial-tool="{{jobSubTool}}" />
    <daily-renovation wx:if="{{lifeTab === 'renovation'}}" initial-tool="{{renovSubTool}}" />
    <daily-living wx:if="{{lifeTab === 'living'}}" initial-tool="{{livingSubTool}}" />
    <daily-health wx:if="{{lifeTab === 'health'}}" initial-tool="{{healthSubTool}}" />
  </view>

  <!-- 底部固定操作栏 -->
  <view class="bottom-bar">
    <button class="btn-share" open-type="share">
      <t-icon name="share" size="32rpx" color="#00288E" />
      <text>分享方案</text>
    </button>
    <view class="btn-poster" hover-class="touch-active" bindtap="goToPoster">
      <t-icon name="image" size="32rpx" color="#FFFFFF" />
      <text>生成财务海报</text>
    </view>
  </view>
</view>
