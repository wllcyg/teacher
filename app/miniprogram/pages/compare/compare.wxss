/** pages/compare/compare.wxss **/

.compare-container {
  min-height: 100vh;
  background-color: var(--bg-color);
  padding-bottom: 40rpx;
  box-sizing: border-box;
}

.custom-navbar {
  --td-navbar-bg-color: #FFFFFF !important;
  --td-navbar-color: var(--text-main) !important;
}

.content-body {
  padding: 24rpx 32rpx;
}

/* 0. 输入表单卡片 */
.input-card {
  background-color: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx 28rpx 24rpx 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(0, 40, 142, 0.06);
}

.input-group {
  display: flex;
  flex-direction: column;
}

.group-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 12rpx;
}

.group-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1E293B;
}

.group-hint {
  font-size: 22rpx;
  color: #94A3B8;
}

.input-row {
  display: flex;
  align-items: center;
  background-color: #F8F9FD;
  border-radius: 18rpx;
  padding: 14rpx 20rpx;
  border: 1rpx solid #E2E8F0;
}

.input-symbol {
  font-size: 36rpx;
  font-weight: 700;
  color: #00288E;
  margin-right: 12rpx;
}

.main-input {
  flex: 1;
  font-size: 40rpx;
  font-weight: 800;
  color: #00288E;
  height: 64rpx;
}

.sub-input {
  font-size: 34rpx;
  font-weight: 700;
  color: #334155;
}

.chips-row {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
  flex-wrap: wrap;
}

.chip-tag {
  padding: 8rpx 20rpx;
  background-color: #F1F5F9;
  border-radius: 100rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #475569;
  transition: all 0.2s ease;
}

.chip-tag.active {
  background-color: #00288E;
  color: #FFFFFF;
}

.input-divider {
  height: 1rpx;
  background-color: #F1F5F9;
  margin: 20rpx 0;
}

/* 盲区告警横幅 */
.blind-warning-card {
  background: linear-gradient(135deg, #FEF2F2 0%, #FFF5F5 100%);
  border: 2rpx solid #FCA5A5;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.blind-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.blind-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #B91C1C;
}

.blind-desc {
  font-size: 22rpx;
  color: #7F1D1D;
  line-height: 1.5;
  display: block;
  margin-bottom: 16rpx;
}

.blind-action {
  display: flex;
  justify-content: flex-end;
}

.btn-safe-fix {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background-color: #DC2626;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 600;
  padding: 10rpx 20rpx;
  border-radius: 100rpx;
  box-shadow: 0 4rpx 10rpx rgba(220, 38, 38, 0.25);
}

/* 1. 省税大看板 */
.highlight-banner {
  background: linear-gradient(135deg, #059669 0%, #10B981 100%);
  border-radius: 32rpx;
  padding: 36rpx 32rpx;
  color: #FFFFFF;
  margin-bottom: 24rpx;
  transition: all 0.3s ease;
}

.highlight-banner.banner-blue {
  background: linear-gradient(135deg, #00288E 0%, #0051D5 100%);
}

.banner-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}

.badge-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255, 255, 255, 0.95);
  padding: 6rpx 16rpx;
  border-radius: 100rpx;
}

.badge-text {
  font-size: 22rpx;
  font-weight: 700;
  color: #059669;
}

.banner-blue .badge-text {
  color: #00288E;
}

.banner-date {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

.save-title {
  font-size: 28rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.95);
}

.save-amount {
  display: flex;
  align-items: baseline;
  margin: 8rpx 0 16rpx 0;
}

.save-amount .symbol {
  font-size: 40rpx;
  font-weight: 600;
  margin-right: 8rpx;
}

.save-amount .num {
  font-size: 68rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
  line-height: 1;
}

.save-amount .unit {
  font-size: 38rpx;
  font-weight: 600;
}

.banner-tip {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.88);
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
  padding-top: 16rpx;
  line-height: 1.4;
}

/* 2. 双方案对比卡片 */
.compare-cards {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.scheme-card {
  background-color: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.scheme-recommend {
  border-color: rgba(5, 150, 105, 0.3);
  background: linear-gradient(180deg, #F0FDF4 0%, #FFFFFF 30%);
}

.scheme-normal {
  border-color: #E2E8F0;
}

.scheme-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.scheme-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.scheme-tag {
  background-color: #059669;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.scheme-tag.tag-gray {
  background-color: #64748B;
}

.scheme-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1E293B;
}

.tax-total {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 16rpx 0;
  border-bottom: 1rpx dashed #E2E8F0;
  margin-bottom: 16rpx;
}

.tax-total .label {
  font-size: 24rpx;
  color: #64748B;
}

.tax-total .val {
  font-size: 36rpx;
  font-weight: 800;
}

.color-green {
  color: #059669;
}

.color-red {
  color: #DC2626;
}

.scheme-details {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.s-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.s-name {
  font-size: 24rpx;
  color: #64748B;
}

.s-val {
  font-size: 24rpx;
  color: #1E293B;
}

/* 3. 对照表卡片 */
.table-card {
  background-color: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.table-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.table-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1E293B;
}

.table-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F1F5F9;
  font-size: 24rpx;
}

.table-head-row {
  background-color: #F8FAFC;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  color: #64748B;
}

.col-item {
  color: #334155;
}

.flex-2 {
  flex: 2;
}

.flex-1 {
  flex: 1;
}

.text-center {
  text-align: center;
}

.font-bold {
  font-weight: 700;
}

/* 4. 贴士卡片 */
.tips-card {
  background-color: #EFF6FF;
  border-radius: 24rpx;
  padding: 24rpx;
  border: 1rpx solid #BFDBFE;
  margin-bottom: 24rpx;
}

.tips-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.tips-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #00288E;
}

.tips-content {
  font-size: 22rpx;
  color: #1E3A8A;
  line-height: 1.6;
  display: block;
}

/* 底部操作栏 */
.bottom-bar-placeholder {
  height: 140rpx;
}

.bottom-action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #FFFFFF;
  padding: 20rpx 32rpx;
  display: flex;
  gap: 20rpx;
  border-top: 1rpx solid #E2E8F0;
  box-shadow: 0 -4rpx 16rpx rgba(11, 28, 48, 0.05);
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  z-index: 100;
}

.action-btn-secondary {
  flex: 1;
  height: 88rpx;
  background-color: #EFF4FF;
  border: 1rpx solid #DCE9FF;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn-secondary .btn-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #00288E;
}

.action-btn-primary {
  flex: 1.8;
  height: 88rpx;
  background: linear-gradient(135deg, #00288E 0%, #0051D5 100%);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: 0 4rpx 14rpx rgba(0, 40, 142, 0.25);
}

.action-btn-primary .btn-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}
