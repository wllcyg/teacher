/** pages/compare/compare.wxss **/

.compare-container {
  min-height: 100vh;
  background-color: var(--bg-color);
  padding-bottom: 40rpx;
  box-sizing: border-box;
}

.custom-navbar {
  --td-navbar-bg-color: #FFFFFF !important;
  --td-navbar-color: var(--text-main) !important;
}

.content-body {
  padding: 24rpx 32rpx;
}

/* 1. 省税大看板 */
.highlight-banner {
  background: linear-gradient(135deg, #059669 0%, #10B981 100%);
  border-radius: 32rpx;
  padding: 36rpx 32rpx;
  color: #FFFFFF;
  margin-bottom: 24rpx;
}

.banner-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}

.badge-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255, 255, 255, 0.95);
  padding: 6rpx 16rpx;
  border-radius: 100rpx;
}

.badge-text {
  font-size: 22rpx;
  font-weight: 700;
  color: #059669;
}

.banner-date {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

.save-title {
  font-size: 28rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.95);
}

.save-amount {
  display: flex;
  align-items: baseline;
  margin: 8rpx 0 16rpx 0;
}

.save-amount .symbol {
  font-size: 40rpx;
  font-weight: 600;
  margin-right: 8rpx;
}

.save-amount .num {
  font-size: 72rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
  line-height: 1;
}

.save-amount .unit {
  font-size: 40rpx;
  font-weight: 600;
}

.banner-tip {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
  padding-top: 16rpx;
}

/* 2. 双方案对比卡片 */
.compare-cards {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.scheme-card {
  background-color: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(220, 233, 255, 0.6);
}

.scheme-recommend {
  border: 2rpx solid #10B981;
  background: linear-gradient(180deg, #F0FDF4 0%, #FFFFFF 30%);
}

.scheme-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.scheme-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.scheme-tag {
  font-size: 22rpx;
  font-weight: 700;
  background-color: #ECFDF5;
  color: #059669;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.tag-gray {
  background-color: #F1F5F9;
  color: #64748B;
}

.scheme-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-main);
}

.tax-total {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding-bottom: 20rpx;
  margin-bottom: 16rpx;
  border-bottom: 1rpx dashed #E2E8F0;
}

.tax-total .label {
  font-size: 26rpx;
  color: var(--text-muted);
}

.tax-total .val {
  font-size: 38rpx;
  font-weight: 800;
}

.color-green { color: #059669 !important; }
.color-red { color: #DC2626 !important; }
.font-bold { font-weight: 700 !important; color: var(--text-main) !important; }

.scheme-details {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.s-row {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
}

.s-name { color: var(--text-regular); }
.s-val { color: var(--text-main); font-weight: 500; }

/* 3. 明细对照表 */
.table-card {
  background-color: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(220, 233, 255, 0.6);
}

.table-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.table-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-main);
}

.table-row {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F1F5FD;
  font-size: 24rpx;
}

.table-head-row {
  background-color: #F8FAFC;
  padding: 16rpx 12rpx;
  border-radius: 12rpx;
  color: var(--text-muted);
  font-weight: 600;
}

.col-item {
  display: flex;
  align-items: center;
}

.flex-1 { flex: 1; }
.flex-2 { flex: 2; }
.text-center { justify-content: center; }

/* 4. 贴士卡片 */
.tips-card {
  background-color: #EFF4FF;
  border-radius: 24rpx;
  padding: 24rpx;
  border: 1rpx solid #DCE9FF;
  margin-bottom: 24rpx;
}

.tips-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.tips-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #00288E;
}

.tips-content {
  font-size: 22rpx;
  color: var(--text-regular);
  line-height: 1.6;
}

/* 底部操作栏 */
.bottom-bar-placeholder {
  height: 140rpx;
}

.bottom-action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #FFFFFF;
  padding: 20rpx 32rpx;
  display: flex;
  gap: 20rpx;
  border-top: 1rpx solid #E2E8F0;
  box-shadow: 0 -4rpx 16rpx rgba(11, 28, 48, 0.05);
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  z-index: 100;
}

.action-btn-secondary {
  flex: 1;
  height: 88rpx;
  background-color: #EFF4FF;
  border: 1rpx solid #DCE9FF;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn-secondary .btn-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #00288E;
}

.action-btn-primary {
  flex: 1.8;
  height: 88rpx;
  background: linear-gradient(135deg, #00288E 0%, #0051D5 100%);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: 0 4rpx 14rpx rgba(0, 40, 142, 0.25);
}

.action-btn-primary .btn-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}
