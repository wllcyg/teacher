/* pages/schedule/index.wxss */
page {
  background-color: #f7f8fa;
  min-height: 100vh;
  box-sizing: border-box;
}

.schedule-container {
  padding: 24rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* 顶部控制与统计卡片 */
.top-header-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  margin-bottom: 24rpx;
}

.header-left {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
  display: flex;
  flex-direction: column;
}

.schedule-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.schedule-main-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1d2129;
  white-space: nowrap;
}

.schedule-sub-tip {
  font-size: 22rpx;
  color: #86909c;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.header-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.header-tool-btn {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 18rpx;
  background-color: #f2f3f5;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #0052d9;
  white-space: nowrap;
  flex-shrink: 0;
  word-break: keep-all;
  transition: all 0.2s ease;
}

.header-tool-btn text {
  white-space: nowrap;
  line-height: 1;
}

.header-tool-btn:active {
  background-color: #e5e6eb;
}

.header-tool-btn.switch-btn {
  background-color: #ecf2fe;
}

/* 星期分段选择器 */
.weekday-segmented-wrap {
  display: flex;
  background-color: #ffffff;
  padding: 10rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.weekday-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 18rpx 0;
  border-radius: 12rpx;
  position: relative;
  transition: all 0.2s ease;
}

.weekday-tab.active {
  background-color: #0052d9;
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(0, 82, 217, 0.25);
}

.weekday-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #4e5969;
}

.weekday-tab.active .weekday-name {
  color: #ffffff;
}

.day-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background-color: #2ba471;
  margin-top: 6rpx;
}

.weekday-tab.active .day-dot {
  background-color: #ffffff;
}

/* 单日课表卡片流 */
.day-lessons-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.lesson-swipe-cell {
  width: 100%;
  display: block;
}

.lesson-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 20rpx;
  border-radius: 18rpx;
  background-color: #ffffff;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.lesson-card:active {
  background-color: #f7f8fa;
}

.lesson-card.has-lesson {
  border: 1rpx solid #e8f3ff;
  border-left: 8rpx solid #0052d9;
}

.lesson-time-box {
  width: 110rpx;
  height: 96rpx;
  border-radius: 14rpx;
  background-color: #ecf2fe;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.period-num-text {
  font-size: 26rpx;
  font-weight: 700;
  color: #0052d9;
}

.period-start-text {
  font-size: 22rpx;
  color: #86909c;
  margin-top: 4rpx;
}

.lesson-main-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.subject-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 8rpx;
}

.subject-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1d2129;
}

.class-badge {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background-color: #e8f8f0;
  color: #00a870;
  font-size: 22rpx;
  font-weight: 600;
}

.meta-row {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #86909c;
}

.classroom-text {
  margin-left: 6rpx;
  color: #4e5969;
}

.lesson-action-icon {
  padding: 10rpx;
}

/* 空堂插槽 */
.lesson-card.empty-slot {
  background-color: #ffffff;
  border: 2rpx dashed #dcdcdc;
  box-shadow: none;
}

.empty-time-box {
  background-color: #f2f3f5;
}

.empty-num {
  color: #86909c;
}

.empty-start {
  color: #c9cdd4;
}

.empty-slot-content {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding-left: 8rpx;
}

.empty-tip-text {
  font-size: 28rpx;
  color: #0052d9;
  font-weight: 500;
}

.empty-duration-tip {
  font-size: 22rpx;
  color: #c9cdd4;
  padding-right: 8rpx;
}

/* 滑动删除操作块 */
.swipe-delete-btn {
  width: 140rpx;
  height: 100%;
  background-color: #e34d59;
  color: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.btn-text {
  font-size: 24rpx;
  font-weight: 500;
  color: #ffffff;
}

/* 全周大矩阵网格 */
.matrix-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.matrix-header-tip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  color: #86909c;
  margin-bottom: 20rpx;
  padding: 0 10rpx;
}

.matrix-scroll-view {
  width: 100%;
  white-space: nowrap;
}

.matrix-grid-table {
  display: flex;
  flex-direction: column;
  min-width: 760rpx;
}

.matrix-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.matrix-header-row {
  margin-bottom: 16rpx;
}

.matrix-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.cell-period-header {
  width: 110rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #86909c;
  padding: 10rpx;
}

.cell-day-header {
  flex: 1;
  min-width: 120rpx;
  padding: 14rpx 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #4e5969;
  background-color: #f7f8fa;
  border-radius: 10rpx;
  margin-left: 8rpx;
  text-align: center;
}

.cell-day-header.is-today {
  background-color: #ecf2fe;
  color: #0052d9;
}

.cell-period-title {
  width: 110rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.cell-period-n {
  font-size: 24rpx;
  font-weight: 700;
  color: #1d2129;
}

.cell-period-t {
  font-size: 20rpx;
  color: #86909c;
}

.cell-content-slot {
  flex: 1;
  min-width: 120rpx;
  height: 110rpx;
  border-radius: 12rpx;
  margin-left: 8rpx;
  background-color: #f7f8fa;
  border: 1rpx dashed #e5e6eb;
  padding: 6rpx;
  transition: all 0.2s ease;
}

.cell-content-slot.has-content {
  background-color: #e8f8f0;
  border: 1rpx solid #b7eb8f;
}

.grid-class-name {
  font-size: 22rpx;
  font-weight: 700;
  color: #00a870;
  text-align: center;
  line-height: 1.2;
}

.grid-subject-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #1d2129;
  margin-top: 4rpx;
}

/* 抽屉弹窗样式 */
.drawer-content {
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  max-height: 85vh;
  box-sizing: border-box;
}

.drawer-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 28rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f2f3f5;
}

.drawer-title-wrap {
  display: flex;
  flex-direction: column;
}

.drawer-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1d2129;
}

.drawer-subtitle {
  font-size: 24rpx;
  color: #0052d9;
  margin-top: 8rpx;
  font-weight: 500;
}

.drawer-close {
  padding: 8rpx;
}

.drawer-body {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  margin-bottom: 36rpx;
}

.form-section {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.section-label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.section-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #1d2129;
}

.required {
  color: #e34d59;
}

.section-tip {
  font-size: 22rpx;
  color: #86909c;
}

/* 排课表单卡片 (紧凑高质感) */
.form-cell-card {
  background-color: #f7f8fa;
  border-radius: 20rpx;
  overflow: hidden;
  border: 1rpx solid #e5e6eb;
}

.form-cell-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 104rpx;
  height: 104rpx;
  padding: 0 28rpx;
  background-color: #ffffff;
  border-bottom: 1rpx solid #f2f3f5;
  box-sizing: border-box;
  transition: background-color 0.2s ease;
}

.form-cell-row:active {
  background-color: #f8f9fa;
}

.form-cell-row.no-border {
  border-bottom: none;
}

.cell-label-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  line-height: 1;
}

.cell-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #1d2129;
  line-height: 1;
}

.cell-required {
  color: #e34d59;
  font-weight: 700;
  line-height: 1;
}

.cell-optional {
  font-size: 22rpx;
  color: #86909c;
  line-height: 1;
}

.cell-value-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  white-space: nowrap;
  line-height: 1;
}

.cell-value-wrap t-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.cell-value-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #0052d9;
  line-height: 1;
  white-space: nowrap;
}

.cell-value-text.is-empty {
  color: #8f959e;
  font-weight: 400;
}

.cell-placeholder {
  font-size: 28rpx;
  color: #8f959e;
  line-height: 1;
  white-space: nowrap;
}

.cell-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  height: 100%;
}

.cell-input {
  width: 100%;
  font-size: 28rpx;
  color: #1d2129;
  text-align: right;
  height: 100%;
}

/* 抽屉底部按钮 */
.drawer-footer {
  display: flex;
  gap: 20rpx;
  width: 100%;
}

.delete-btn {
  flex-shrink: 0;
  width: 220rpx;
}

/* 复制整天目标天选择器 */
.target-days-group {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 10rpx;
}

.target-day-chip {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 28rpx;
  background-color: #f7f8fa;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: #1d2129;
  border: 1rpx solid #e5e6eb;
  transition: all 0.2s ease;
}

.target-day-chip.selected {
  background-color: #ecf2fe;
  border-color: #0052d9;
  color: #0052d9;
}
