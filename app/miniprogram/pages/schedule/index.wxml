<!--pages/schedule/index.wxml-->
<view class="schedule-container">
  <!-- 顶部控制与统计卡片 -->
  <view class="top-header-card">
    <view class="header-left">
      <view class="schedule-title-row">
        <text class="schedule-main-title">我的任教课表</text>
        <t-tag theme="primary" size="small" variant="light">共排 {{totalLessonsCount}} 节</t-tag>
      </view>
      <text class="schedule-sub-tip">点击空节次快速排课，左右滑动或点击切换</text>
    </view>

    <view class="header-right">
      <!-- 复制本日课表入口 -->
      <view 
        class="header-tool-btn" 
        bindtap="openCopyModal" 
        wx:if="{{currentDayLessonsCount > 0 && viewMode === 'single'}}"
      >
        <t-icon name="file-copy" size="28rpx" color="#0052d9" />
        <text>复制</text>
      </view>

      <!-- 模式切换：单日聚焦 ⇄ 全周矩阵 -->
      <view class="header-tool-btn switch-btn" bindtap="toggleViewMode">
        <t-icon name="{{viewMode === 'single' ? 'view-module' : 'calendar'}}" size="28rpx" color="#0052d9" />
        <text>{{viewMode === 'single' ? '全周总览' : '单日课表'}}</text>
      </view>
    </view>
  </view>

  <!-- 单日聚焦模式 -->
  <block wx:if="{{viewMode === 'single'}}">
    <!-- 星期导航横向滑块 -->
    <view class="weekday-segmented-wrap">
      <view 
        wx:for="{{weekdays}}" 
        wx:key="*this"
        class="weekday-tab {{selectedDay === item ? 'active' : ''}}"
        bindtap="onSelectWeekday"
        data-day="{{item}}"
      >
        <text class="weekday-name">{{item}}{{todayWeekday === item ? '(今)' : ''}}</text>
        <view class="day-dot" wx:if="{{dayCounts[item] > 0}}"></view>
      </view>
    </view>

    <!-- 当天纵向课程列表 -->
    <view class="day-lessons-list">
      <block wx:for="{{periods}}" wx:key="n">
        <!-- 场景 A：该节次已有排课 -->
        <block wx:if="{{cellMap[selectedDay + '-' + item.n]}}">
          <t-swipe-cell class="lesson-swipe-cell">
            <view 
              class="lesson-card has-lesson" 
              bindtap="openEditModal" 
              data-lesson="{{cellMap[selectedDay + '-' + item.n]}}"
              data-period="{{item}}"
            >
              <view class="lesson-time-box">
                <text class="period-num-text">第 {{item.n}} 节</text>
                <text class="period-start-text">{{item.start}}</text>
              </view>

              <view class="lesson-main-info">
                <view class="subject-row">
                  <text class="subject-name">{{cellMap[selectedDay + '-' + item.n].subject}}</text>
                  <view class="class-badge">
                    {{cellMap[selectedDay + '-' + item.n].class_name}}
                  </view>
                </view>
                <view class="meta-row">
                  <text class="time-range-text">起止：{{item.start}} - {{item.end}}</text>
                  <text class="classroom-text" wx:if="{{cellMap[selectedDay + '-' + item.n].classroom}}">
                    · {{cellMap[selectedDay + '-' + item.n].classroom}}
                  </text>
                </view>
              </view>

              <view class="lesson-action-icon">
                <t-icon name="edit" size="32rpx" color="#8f959e" />
              </view>
            </view>

            <!-- 左滑快捷删除按钮 -->
            <view 
              slot="right" 
              class="swipe-delete-btn" 
              catchtap="onDeleteLesson" 
              data-id="{{cellMap[selectedDay + '-' + item.n].id}}"
              data-desc="第 {{item.n}} 节 {{cellMap[selectedDay + '-' + item.n].subject}}"
            >
              <t-icon name="delete" size="36rpx" color="#ffffff" />
              <text class="btn-text">清空</text>
            </view>
          </t-swipe-cell>
        </block>

        <!-- 场景 B：该节次未排课（空堂） -->
        <block wx:else>
          <view 
            class="lesson-card empty-slot" 
            bindtap="openAddModal" 
            data-day="{{selectedDay}}" 
            data-period="{{item}}"
          >
            <view class="lesson-time-box empty-time-box">
              <text class="period-num-text empty-num">第 {{item.n}} 节</text>
              <text class="period-start-text empty-start">{{item.start}}</text>
            </view>

            <view class="empty-slot-content">
              <t-icon name="add-circle" size="32rpx" color="#0052d9" />
              <text class="empty-tip-text">本节空堂 · 点击排课</text>
            </view>

            <view class="empty-duration-tip">
              {{item.duration}} 分钟
            </view>
          </view>
        </block>
      </block>
    </view>
  </block>

  <!-- 全周大矩阵总览模式 -->
  <block wx:else>
    <view class="matrix-card">
      <view class="matrix-header-tip">
        <t-icon name="gesture-left" size="28rpx" color="#8f959e" />
        <text>可横向左右滑动查看完整 5 天周课表矩阵，点击格子微调</text>
      </view>

      <scroll-view scroll-x class="matrix-scroll-view" enable-flex>
        <view class="matrix-grid-table">
          <!-- 网格表头 -->
          <view class="matrix-row matrix-header-row">
            <view class="matrix-cell cell-period-header">节次</view>
            <view 
              wx:for="{{weekdays}}" 
              wx:key="*this" 
              class="matrix-cell cell-day-header {{todayWeekday === item ? 'is-today' : ''}}"
            >
              {{item}}
            </view>
          </view>

          <!-- 网格节次各行 -->
          <view wx:for="{{periods}}" wx:key="n" class="matrix-row">
            <view class="matrix-cell cell-period-title">
              <text class="cell-period-n">第{{item.n}}节</text>
              <text class="cell-period-t">{{item.start}}</text>
            </view>

            <view 
              wx:for="{{weekdays}}" 
              wx:for-item="d" 
              wx:key="*this"
              class="matrix-cell cell-content-slot {{cellMap[d + '-' + item.n] ? 'has-content' : ''}}"
              bindtap="onGridCellTap"
              data-day="{{d}}"
              data-period="{{item}}"
            >
              <block wx:if="{{cellMap[d + '-' + item.n]}}">
                <text class="grid-class-name">{{cellMap[d + '-' + item.n].class_name}}</text>
                <text class="grid-subject-name">{{cellMap[d + '-' + item.n].subject}}</text>
              </block>
              <block wx:else>
                <t-icon name="add" size="28rpx" color="#c9cdd4" />
              </block>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </block>

  <!-- 极速排课 / 编辑课程抽屉 -->
  <t-popup visible="{{isEditDrawerVisible}}" placement="bottom" bind:visible-change="onDrawerVisibleChange">
    <view class="drawer-content">
      <view class="drawer-header">
        <view class="drawer-title-wrap">
          <text class="drawer-title">{{editingLessonId ? '编辑课程' : '极速排课'}}</text>
          <text class="drawer-subtitle">{{form.weekday}} · 第 {{form.period_n}} 节 ({{currentPeriodTimeStr}})</text>
        </view>
        <view class="drawer-close" bindtap="closeDrawer">
          <t-icon name="close" size="36rpx" color="#8f959e" />
        </view>
      </view>

      <view class="drawer-body">
        <view class="form-cell-card">
          <!-- 1. 授课班级滚动选择行 -->
          <view class="form-cell-row" bindtap="openClassPicker">
            <view class="cell-label-wrap">
              <text class="cell-label">授课班级</text>
              <text class="cell-required">*</text>
            </view>
            <view class="cell-value-wrap">
              <block wx:if="{{form.class_name}}">
                <text class="cell-value-text">{{selectedClassLabel || form.class_name}}</text>
              </block>
              <block wx:else>
                <text class="cell-placeholder">点击滚动选择班级</text>
              </block>
              <t-icon name="chevron-right" size="36rpx" color="#8f959e" />
            </view>
          </view>

          <!-- 2. 授课科目滚动选择行 -->
          <view class="form-cell-row" bindtap="openSubjectPicker">
            <view class="cell-label-wrap">
              <text class="cell-label">授课科目</text>
              <text class="cell-required">*</text>
            </view>
            <view class="cell-value-wrap">
              <text class="cell-value-text {{form.subject ? '' : 'is-empty'}}">{{form.subject || '点击滚动选择科目'}}</text>
              <t-icon name="chevron-right" size="36rpx" color="#8f959e" />
            </view>
          </view>

          <!-- 3. 上课教室选填行 -->
          <view class="form-cell-row no-border">
            <view class="cell-label-wrap">
              <text class="cell-label">上课教室</text>
              <text class="cell-optional">(选填)</text>
            </view>
            <view class="cell-input-wrap">
              <input 
                class="cell-input" 
                placeholder="例如：主楼302 / 实验楼 / 操场" 
                value="{{form.classroom}}" 
                bindinput="onClassroomInput"
              />
            </view>
          </view>
        </view>
      </view>

      <!-- 抽屉底部操作栏 -->
      <view class="drawer-footer">
        <t-button 
          wx:if="{{editingLessonId}}" 
          theme="danger" 
          variant="outline" 
          size="large" 
          bindtap="onDeleteFromDrawer"
          class="delete-btn"
        >
          删除此课
        </t-button>
        <t-button 
          theme="primary" 
          size="large" 
          block 
          loading="{{isSubmitting}}"
          bindtap="submitLessonForm"
        >
          {{editingLessonId ? '保存修改' : '确认排入'}}
        </t-button>
      </view>
    </view>
  </t-popup>

  <!-- 一键复制整天课表弹窗 -->
  <t-popup visible="{{isCopyModalVisible}}" placement="bottom" bind:visible-change="onCopyModalVisibleChange">
    <view class="drawer-content">
      <view class="drawer-header">
        <view class="drawer-title-wrap">
          <text class="drawer-title">复制【{{selectedDay}}】课表</text>
          <text class="drawer-subtitle">将当天的所有排课一键克隆覆盖到其他星期</text>
        </view>
        <view class="drawer-close" bindtap="closeCopyModal">
          <t-icon name="close" size="36rpx" color="#8f959e" />
        </view>
      </view>

      <view class="drawer-body">
        <text class="section-label">选择要复制的目标星期（可多选）：</text>
        <view class="target-days-group">
          <view 
            wx:for="{{weekdays}}" 
            wx:key="*this"
            wx:if="{{item !== selectedDay}}"
            class="target-day-chip {{copyTargetDays[item] ? 'selected' : ''}}"
            bindtap="toggleCopyTargetDay"
            data-day="{{item}}"
          >
            <t-icon name="{{copyTargetDays[item] ? 'check-circle-filled' : 'circle'}}" size="32rpx" color="{{copyTargetDays[item] ? '#0052d9' : '#c9cdd4'}}" />
            <text>{{item}}</text>
          </view>
        </view>
      </view>

      <view class="drawer-footer">
        <t-button 
          theme="primary" 
          size="large" 
          block 
          loading="{{isCopying}}" 
          bindtap="submitBatchCopy"
        >
          确认复制并覆盖
        </t-button>
      </view>
    </view>
  </t-popup>

  <!-- TDesign 授课班级弹出滚动选择器 (WeApp 组件控制) -->
  <t-picker
    visible="{{isClassPickerVisible}}"
    value="{{classPickerValue}}"
    title="选择授课班级"
    cancelBtn="取消"
    confirmBtn="确定"
    bindchange="onConfirmClassPicker"
    bindcancel="onCancelClassPicker"
  >
    <t-picker-item options="{{classPickerOptions}}" />
  </t-picker>

  <!-- TDesign 授课科目弹出滚动选择器 (WeApp 组件控制) -->
  <t-picker
    visible="{{isSubjectPickerVisible}}"
    value="{{subjectPickerValue}}"
    title="选择授课科目"
    cancelBtn="取消"
    confirmBtn="确定"
    bindchange="onConfirmSubjectPicker"
    bindcancel="onCancelSubjectPicker"
  >
    <t-picker-item options="{{subjectPickerOptions}}" />
  </t-picker>
</view>

