/* pages/lesson-logs/index.wxss */
page {
  background-color: #f7f8fa;
  min-height: 100vh;
  box-sizing: border-box;
}

.logs-container {
  padding: 24rpx;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* ================= 1. 顶部总览卡片 ================= */
.stats-overview-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  margin-bottom: 24rpx;
}

.stats-left {
  flex: 1;
  min-width: 0;
  margin-right: 20rpx;
}

.stats-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.stats-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1d2129;
}

.stats-sub {
  font-size: 24rpx;
  color: #86909c;
  line-height: 1.4;
  display: block;
}

.stats-right-badge {
  background-color: #ecf2fe;
  border-radius: 20rpx;
  padding: 14rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.stats-highlight-num {
  font-size: 38rpx;
  font-weight: 800;
  color: #0052d9;
  line-height: 1;
}

.stats-highlight-label {
  font-size: 20rpx;
  color: #0052d9;
  margin-top: 4rpx;
}

/* ================= 2. 年级/班级 TDesign Tabs 卡片 ================= */
.tabs-card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 12rpx 16rpx 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
}

.custom-class-tabs {
  --td-tab-item-active-color: #0052d9;
  --td-tab-track-color: #0052d9;
  margin-bottom: 14rpx;
}

.search-wrap {
  padding: 0 8rpx;
}

/* ================= 3. 时光轴卡片流与 Swipe-Cell ================= */
.timeline-wrap {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.date-group-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 8rpx 4rpx;
}

.date-header-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.date-title-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #1d2129;
}

.weekday-badge {
  background-color: #ecf2fe;
  color: #0052d9;
  font-size: 22rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  font-weight: 600;
}

.group-count-text {
  font-size: 24rpx;
  color: #86909c;
}

.cards-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.swipe-cell-item {
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.02);
}

.lesson-card-item {
  background-color: #ffffff;
  border-radius: 20rpx;
  border: 1rpx solid #e5e6eb;
  padding: 24rpx;
  box-sizing: border-box;
  transition: all 0.15s ease;
}

.card-hover {
  background-color: #f8fafc;
}

.card-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.lesson-meta-tag {
  background-color: #ecf2fe;
  color: #0052d9;
  font-size: 24rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
}

.card-action-hint {
  display: flex;
  align-items: center;
  gap: 2rpx;
}

.hint-text {
  font-size: 22rpx;
  color: #c0c4cc;
}

.card-content-text {
  font-size: 28rpx;
  color: #1d2129;
  line-height: 1.5;
}

/* Swipe-Cell 右侧滑出按钮 */
.swipe-actions-row {
  display: flex;
  height: 100%;
}

.swipe-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 130rpx;
  height: 100%;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 500;
  gap: 6rpx;
}

.swipe-btn.edit-action {
  background-color: #0052d9;
}

.swipe-btn.delete-action {
  background-color: #e34d59;
}

/* ================= 4. 分页加载与底线 ================= */
.load-more-row {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 32rpx 0 16rpx;
}

.no-more-row {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 36rpx 0 20rpx;
  font-size: 24rpx;
  color: #c0c4cc;
}

/* ================= 5. 空状态与底垫 ================= */
.empty-state-wrap {
  padding: 80rpx 0;
}

.bottom-safe-spacer {
  height: 60rpx;
}

/* ================= 6. 抽屉弹窗 ================= */
.modal-wrapper {
  background-color: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  max-height: 85vh;
  box-sizing: border-box;
}

.modal-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.modal-title-group {
  display: flex;
  flex-direction: column;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1d2129;
  margin-bottom: 4rpx;
}

.modal-subtitle {
  font-size: 24rpx;
  color: #86909c;
}

.modal-close-btn {
  padding: 8rpx;
}

.form-group-wrap {
  margin-bottom: 24rpx;
}

.form-group-wrap .t-cell-group--card {
  margin: 0 !important;
  border: 1rpx solid #f2f3f5;
  border-radius: 16rpx;
  overflow: hidden;
}

.quick-tags-section {
  margin-bottom: 24rpx;
}

.quick-tags-title {
  font-size: 24rpx;
  color: #86909c;
  display: block;
  margin-bottom: 12rpx;
}

.quick-tag-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.quick-pill {
  background-color: #f2f3f5;
  color: #4e5969;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  transition: all 0.15s ease;
}

.quick-pill:active {
  background-color: #ecf2fe;
  color: #0052d9;
}

.textarea-section {
  margin-bottom: 32rpx;
}

.custom-textarea {
  background-color: #f7f8fa !important;
  border-radius: 16rpx !important;
}

.modal-footer {
  margin-top: 8rpx;
}

.modal-btns-row {
  display: flex;
  gap: 16rpx;
}
