<!--pages/lesson-logs/index.wxml-->
<view class="logs-container">
  <!-- 1. 顶部教学记录统计总览 -->
  <view class="stats-overview-card">
    <view class="stats-left">
      <view class="stats-title-row">
        <text class="stats-title">课堂教学台账</text>
        <t-tag theme="primary" size="small" variant="light">共 {{totalLogsCount}} 节</t-tag>
      </view>
      <text class="stats-sub">{{selectedClassText}} · 授课进度与作业记录</text>
    </view>
    <view class="stats-right-badge">
      <text class="stats-highlight-num">{{logsList.length}}</text>
      <text class="stats-highlight-label">当前展示</text>
    </view>
  </view>

  <!-- 2. 年级 / 班级 TDesign Tabs（主筛选器） -->
  <view class="tabs-card">
    <t-tabs 
      value="{{selectedClass}}" 
      bind:change="onClassTabChange"
      space-evenly="{{false}}"
      t-class="custom-class-tabs"
    >
      <t-tab-panel 
        wx:for="{{classTabs}}" 
        wx:key="value" 
        label="{{item.label}}" 
        value="{{item.value}}" 
      />
    </t-tabs>

    <!-- 搜索框 -->
    <view class="search-wrap">
      <t-search 
        value="{{searchKeyword}}" 
        placeholder="搜索讲课内容、章节、作业或背诵要求" 
        shape="round"
        bind:change="onSearchChange"
        bind:clear="onSearchClear"
      />
    </view>
  </view>

  <!-- 3. 教学日志时光轴卡片流（使用 t-swipe-cell 支持左滑编辑与删除） -->
  <view class="timeline-wrap" wx:if="{{groupedLogs.length > 0}}">
    <block wx:for="{{groupedLogs}}" wx:key="date" wx:for-item="group">
      <!-- 日期分组吸附标题 -->
      <view class="date-group-header">
        <view class="date-header-left">
          <t-icon name="calendar" size="30rpx" color="#0052d9" />
          <text class="date-title-text">{{group.formattedDate}}</text>
          <text class="weekday-badge">{{group.weekday}}</text>
        </view>
        <text class="group-count-text">共 {{group.items.length}} 节课</text>
      </view>

      <!-- 课时卡片列表 -->
      <view class="cards-list">
        <t-swipe-cell 
          wx:for="{{group.items}}" 
          wx:key="id"
          class="swipe-cell-item"
        >
          <!-- 默认内容：课堂卡片 -->
          <view 
            class="lesson-card-item" 
            bindtap="onEditLog"
            data-item="{{item}}"
            hover-class="card-hover"
            hover-stay-time="100"
          >
            <view class="card-top-row">
              <view class="lesson-meta-tag">
                <text>{{item.period_str}} · {{item.class_name}}{{item.subject ? ' · ' + item.subject : ''}}</text>
              </view>
              <view class="card-action-hint">
                <text class="hint-text">左滑操作</text>
                <t-icon name="chevron-right" size="28rpx" color="#c0c4cc" />
              </view>
            </view>
            <view class="card-content-text">
              <text>{{item.content}}</text>
            </view>
          </view>

          <!-- 右侧滑动操作按钮 -->
          <view slot="right" class="swipe-actions-row">
            <view 
              class="swipe-btn edit-action" 
              catchtap="onEditLog" 
              data-item="{{item}}"
            >
              <t-icon name="edit" size="36rpx" color="#ffffff" />
              <text>编辑</text>
            </view>
            <view 
              class="swipe-btn delete-action" 
              catchtap="openDeleteDialog" 
              data-id="{{item.id}}" 
              data-item="{{item}}"
            >
              <t-icon name="delete" size="36rpx" color="#ffffff" />
              <text>删除</text>
            </view>
          </view>
        </t-swipe-cell>
      </view>
    </block>

    <!-- 4. 滚动加载更多状态提示 -->
    <view class="load-more-row" wx:if="{{isFetchingMore}}">
      <t-loading theme="circular" size="36rpx" text="正在加载更多记录..." />
    </view>
    <view class="no-more-row" wx:elif="{{!hasMore && logsList.length >= 8}}">
      <text>— 已加载全部 {{totalLogsCount}} 节课堂记录 —</text>
    </view>
  </view>

  <!-- 5. 空状态提示 -->
  <view class="empty-state-wrap" wx:elif="{{!isLoading}}">
    <t-empty 
      icon="info-circle-filled" 
      description="{{emptyDescription}}"
    >
      <view slot="action" class="empty-actions">
        <t-button 
          wx:if="{{selectedClass !== 'ALL' || searchKeyword}}"
          theme="light" 
          size="medium" 
          style="margin-right: 16rpx;"
          bindtap="resetAllFilters"
        >
          查看全部记录
        </t-button>
        <t-button 
          theme="primary" 
          size="medium" 
          icon="add" 
          bindtap="openCreateModal"
        >
          补记一节课堂
        </t-button>
      </view>
    </t-empty>
  </view>

  <!-- 底部安全垫片 -->
  <view class="bottom-safe-spacer"></view>

  <!-- 6. 右下角标准 T-Fab 悬浮补记按钮 -->
  <t-fab
    icon="add"
    text="补记课程"
    aria-label="补记课程"
    bind:click="openCreateModal"
    style="right: 32rpx; bottom: calc(48rpx + env(safe-area-inset-bottom)); z-index: 99;"
  />

  <!-- 7. 抽屉弹窗：新增 / 编辑教学日志 -->
  <t-popup visible="{{isModalVisible}}" placement="bottom" bind:visible-change="onModalVisibleChange">
    <view class="modal-wrapper">
      <view class="modal-header">
        <view class="modal-title-group">
          <text class="modal-title">{{editingId ? '编辑教学记录' : '新增 / 补记教学记录'}}</text>
          <text class="modal-subtitle">记录授课章节、背诵默写要求或课后作业</text>
        </view>
        <view class="modal-close-btn" bindtap="closeModal">
          <t-icon name="close" size="36rpx" color="#8f959e" />
        </view>
      </view>

      <view class="modal-body">
        <!-- TDesign Cell 表单组 -->
        <view class="form-group-wrap">
          <t-cell-group theme="card">
            <!-- 授课日期 -->
            <t-cell 
              title="授课日期" 
              note="{{form.date}}" 
              arrow 
              hover 
              bindtap="openDatePicker"
            >
              <t-icon slot="left-icon" name="calendar" size="36rpx" color="#0052d9" />
            </t-cell>

            <!-- 授课班级 -->
            <t-cell 
              title="授课班级" 
              note="{{form.class_name || '请选择班级'}}" 
              arrow 
              hover 
              bindtap="openClassPicker"
            >
              <t-icon slot="left-icon" name="usergroup" size="36rpx" color="#0052d9" />
            </t-cell>

            <!-- 课时节次 -->
            <t-cell 
              title="课时节次" 
              note="{{form.period_str || '请选择节次'}}" 
              arrow 
              hover 
              bindtap="openPeriodPicker"
            >
              <t-icon slot="left-icon" name="time" size="36rpx" color="#0052d9" />
            </t-cell>
          </t-cell-group>
        </view>

        <!-- 快捷短语填充 -->
        <view class="quick-tags-section">
          <text class="quick-tags-title">快捷填充常用短语：</text>
          <view class="quick-tag-pills">
            <view 
              class="quick-pill" 
              wx:for="{{quickPhrases}}" 
              wx:key="*this"
              bindtap="onSelectQuickPhrase"
              data-text="{{item}}"
            >
              <text>{{item}}</text>
            </view>
          </view>
        </view>

        <!-- 授课内容 TDesign Textarea -->
        <view class="textarea-section">
          <t-textarea 
            value="{{form.content}}" 
            placeholder="请输入授课进度、重点内容、作业或背诵要求（如：讲第一章第三节，背诵课本3~6页）" 
            maxlength="500"
            indicator
            bordered
            bind:change="onInputContent"
            t-class="custom-textarea"
          />
        </view>
      </view>

      <!-- 弹窗底部操作按钮 -->
      <view class="modal-footer">
        <view class="modal-btns-row">
          <t-button 
            wx:if="{{editingId}}" 
            theme="danger" 
            variant="outline" 
            size="large" 
            style="flex: 1;"
            bindtap="deleteCurrentEditing"
          >
            删除记录
          </t-button>
          <t-button 
            theme="primary" 
            size="large" 
            style="flex: 2;"
            loading="{{isSubmitting}}"
            disabled="{{!form.content}}"
            bindtap="submitRecord"
          >
            保存记录
          </t-button>
        </view>
      </view>
    </view>
  </t-popup>

  <!-- 8. 日期选择器 T-Date-Time-Picker -->
  <t-date-time-picker
    title="选择授课日期"
    visible="{{isDatePickerVisible}}"
    mode="date"
    value="{{form.date}}"
    format="YYYY-MM-DD"
    start="{{datePickerStart}}"
    end="{{datePickerEnd}}"
    bind:confirm="onDatePickerConfirm"
    bind:cancel="onDatePickerCancel"
  />

  <!-- 9. 班级选择器 T-Picker -->
  <t-picker
    visible="{{isClassPickerVisible}}"
    value="{{[form.class_name]}}"
    title="选择授课班级"
    cancelBtn="取消"
    confirmBtn="确认"
    bind:confirm="onClassPickerConfirm"
    bind:cancel="onClassPickerCancel"
  >
    <t-picker-item options="{{classPickerOptions}}" />
  </t-picker>

  <!-- 10. 节次选择器 T-Picker -->
  <t-picker
    visible="{{isPeriodPickerVisible}}"
    value="{{[form.period_str]}}"
    title="选择课时节次"
    cancelBtn="取消"
    confirmBtn="确认"
    bind:confirm="onPeriodPickerConfirm"
    bind:cancel="onPeriodPickerCancel"
  >
    <t-picker-item options="{{periodPickerOptions}}" />
  </t-picker>

  <!-- 11. 删除确认对话框 T-Dialog -->
  <t-dialog
    visible="{{isDeleteDialogOpen}}"
    title="确认删除记录"
    content="确定要删除这条课堂教学记录吗？删除后数据不可恢复。"
    confirm-btn="{{ { content: '确认删除', theme: 'danger' } }}"
    cancel-btn="取消"
    bind:confirm="onConfirmDelete"
    bind:cancel="onCancelDelete"
  />
</view>
