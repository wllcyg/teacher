.featured-container {
  min-height: 100vh;
  background-color: var(--bg-color);
  padding: 24rpx 32rpx 48rpx;
  box-sizing: border-box;
}

.hero-banner {
  background: linear-gradient(135deg, var(--primary-color) 0%, #001353 100%);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  color: var(--card-bg);
  margin-bottom: 32rpx;
  box-shadow: 0 12rpx 28rpx rgba(0, 40, 142, 0.18);
}

.banner-badge {
  display: inline-block;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(8px);
  padding: 6rpx 16rpx;
  border-radius: 30rpx;
  font-size: 22rpx;
  font-weight: 500;
  margin-bottom: 16rpx;
  letter-spacing: 1rpx;
}

.banner-title {
  font-size: 38rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
  letter-spacing: 0.5rpx;
}

.banner-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.4;
}

.topic-card {
  background: var(--card-bg);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(226, 232, 240, 0.8);
  transition: all 0.2s ease;
}

.topic-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.topic-tag {
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.tag-blue {
  background: #EEF2FF;
  color: var(--primary-color);
}

.tag-purple {
  background: #F3E8FF;
  color: #7C3AED;
}

.tag-amber {
  background: #FEF3C7;
  color: var(--warning-color);
}

.tag-green {
  background: #D1FAE5;
  color: var(--success-color);
}

.topic-heat {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: var(--text-muted);
}

.heat-text {
  font-size: 22rpx;
  color: var(--text-muted);
}

.topic-body {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 20rpx;
}

.topic-info {
  flex: 1;
}

.topic-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 10rpx;
  line-height: 1.35;
}

.topic-sub {
  display: block;
  font-size: 24rpx;
  color: var(--text-regular);
  line-height: 1.45;
}

.topic-action {
  flex-shrink: 0;
}
