/* pages/roster/index.wxss */
page {
  background-color: #f6f7fb;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  color: #1d2129;
}

.roster-page {
  padding: 24rpx;
}

/* 顶部概况卡片 */
.header-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  margin-bottom: 24rpx;
}

.header-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.class-info {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.class-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1d2129;
}

.student-count-badge {
  font-size: 22rpx;
  color: #0052d9;
  background: #f0f5ff;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.duty-summary {
  font-size: 24rpx;
  color: #86909c;
}

.search-box {
  margin-top: 10rpx;
}

/* 字母索引名册容器 */
.indexes-container {
  margin-top: 8rpx;
  position: relative;
  --td-indexes-sidebar-item-size: 34rpx;
  --td-indexes-sidebar-right: 10rpx;
}

.group-student-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 8rpx 0 16rpx;
}

/* 底部防遮挡专用避让垫片 */
.bottom-safe-spacer {
  height: calc(160rpx + env(safe-area-inset-bottom));
  width: 100%;
  pointer-events: none;
}

/* 学生名册列表 */
.student-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.student-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
  border: 1rpx solid rgba(0, 0, 0, 0.02);
  transition: transform 0.2s ease, background 0.2s ease;
}

.student-card:active {
  background: #fafbfc;
  transform: scale(0.995);
}

/* 头像徽标 */
.student-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #eef2f8;
  color: #4e5969;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.student-avatar.avatar-monitor {
  background: #fff1b8;
  color: #d46b08;
  border: 2rpx solid #ffd591;
}

.student-avatar.avatar-leader {
  background: #bae0ff;
  color: #0958d9;
  border: 2rpx solid #91caff;
}

/* 信息主体 */
.student-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.student-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1d2129;
}

/* 小组专属微标 */
.group-tag {
  font-size: 20rpx;
  font-weight: 600;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  line-height: 1.4;
  background: #f0f5ff;
  color: #2f54eb;
  border: 1rpx solid #adc6ff;
}

/* 职务专属标签：班长、组长 */
.duty-tag {
  font-size: 20rpx;
  font-weight: 600;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  line-height: 1.4;
}

.tag-monitor {
  background: #fff7e6;
  color: #d46b08;
  border: 1rpx solid #ffd591;
}

.tag-leader {
  background: #e6f4ff;
  color: #0958d9;
  border: 1rpx solid #91caff;
}

.gender-text {
  font-size: 22rpx;
  color: #86909c;
  background: #f2f3f5;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.sub-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #86909c;
}

.student-no {
  color: #86909c;
}

.remarks-snippet {
  color: #c9cdd4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 320rpx;
}

.card-arrow {
  padding: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 空状态 */
.empty-wrap {
  padding: 80rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.94);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.bottom-btn-half {
  flex: 1;
}

/* 抽屉弹窗公用 */
.modal-content {
  background: #ffffff;
  border-top-left-radius: 28rpx;
  border-top-right-radius: 28rpx;
  padding: 32rpx 32rpx 48rpx;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f2f3f5;
}

.modal-title-wrap {
  display: flex;
  flex-direction: column;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1d2129;
}

.modal-subtitle {
  font-size: 22rpx;
  color: #86909c;
  margin-top: 4rpx;
}

.modal-close {
  padding: 8rpx;
}

.modal-body {
  padding: 24rpx 0;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  overflow-y: auto;
}

/* 批量录入组件 */
.tips-card {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  background: #f0f5ff;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
}

.tips-text {
  font-size: 24rpx;
  color: #0052d9;
  line-height: 1.5;
  flex: 1;
}

.batch-action-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
  margin-bottom: 6rpx;
}

.bar-left-hint {
  font-size: 22rpx;
  color: #86909c;
}

.ai-trigger-btn {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 22rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #0052d9 0%, #722ed1 100%);
  color: #ffffff;
  box-shadow: 0 4rpx 14rpx rgba(114, 46, 209, 0.28);
  transition: all 0.2s ease;
}

.ai-trigger-btn:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.ai-trigger-btn.loading {
  opacity: 0.65;
}

.ai-btn-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #ffffff;
}

.batch-textarea-wrap {
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx;
  border: 1rpx solid #e5e6eb;
}

.batch-textarea {
  width: 100%;
  height: 220rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #1d2129;
}

/* 智能解析预览列表 */
.parsed-preview-box {
  background: #fafbfc;
  border-radius: 12rpx;
  padding: 20rpx;
  border: 1rpx dashed #d9d9d9;
}

.preview-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.preview-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #4e5969;
}

.clear-text {
  font-size: 24rpx;
  color: #e34d59;
}

.chips-container {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  max-height: 200rpx;
  overflow-y: auto;
}

.name-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: #ffffff;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #1d2129;
  border: 1rpx solid #e5e6eb;
}

.name-chip.chip-monitor {
  background: #fffbe6;
  border-color: #ffe58f;
  color: #d46b08;
}

.name-chip.chip-leader {
  background: #e6f7ff;
  border-color: #91d5ff;
  color: #0958d9;
}

.chip-group-badge {
  font-size: 18rpx;
  font-weight: 600;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  background: #f0f5ff;
  color: #2f54eb;
}

.chip-duty-badge {
  font-size: 20rpx;
  font-weight: 600;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  background: rgba(0, 0, 0, 0.05);
}

.name-chip.chip-duplicate {
  border-color: #fa8c16;
}

.duplicate-tips-bar {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 14rpx;
  padding: 10rpx 14rpx;
  background: #fff7e6;
  border-radius: 8rpx;
}

.duplicate-text {
  font-size: 22rpx;
  color: #d46b08;
  line-height: 1.4;
}

/* 单个表单 */
.form-row {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.form-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #333842;
}

.required {
  color: #e34d59;
}

.input-box {
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 0 24rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid #e5e6eb;
  box-sizing: border-box;
}

.inner-input {
  font-size: 28rpx;
  color: #1d2129;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
}

/* 职务快捷胶囊：无职务、班长、组长 */
.duty-chip-group, .gender-chip-group {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.duty-chip, .gender-chip {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: #4e5969;
  background: #f2f3f5;
  border-radius: 12rpx;
  border: 1rpx solid transparent;
  transition: all 0.2s ease;
}

.duty-chip.active, .gender-chip.active {
  color: #0052d9;
  background: #ecf2fe;
  border-color: #0052d9;
  font-weight: 600;
}

.duty-chip.monitor-chip.active {
  color: #d46b08;
  background: #fff7e6;
  border-color: #ffd591;
}

.duty-chip.leader-chip.active {
  color: #0958d9;
  background: #e6f4ff;
  border-color: #91caff;
}

/* 学习小组点选胶囊 */
.group-chip-group {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.group-select-chip {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: #4e5969;
  background: #f2f3f5;
  border-radius: 12rpx;
  border: 1rpx solid transparent;
  transition: all 0.2s ease;
}

.group-select-chip.active {
  color: #2f54eb;
  background: #f0f5ff;
  border-color: #2f54eb;
  font-weight: 600;
}

.single-modal-footer {
  display: flex;
  gap: 16rpx;
  margin-top: 10rpx;
}
