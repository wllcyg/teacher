<!--pages/mine/index.wxml-->
<view class="mine-container">
  <!-- 教师个人信息卡片 -->
  <view class="profile-card">
    <button class="avatar-button-wrap" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
      <t-avatar image="{{teacher.avatar_url || ''}}" icon="user" size="large" shape="round" />
      <view class="avatar-badge-edit">
        <t-icon name="camera" size="28rpx" color="#ffffff" />
      </view>
    </button>

    <view class="profile-info" bindtap="openEditPopup">
      <view class="profile-name-row">
        <text class="profile-name">{{teacher.name || '点击完善教师信息'}}</text>
        <t-tag wx:if="{{teacher.subject}}" theme="primary" size="small" variant="light">{{teacher.subject}}</t-tag>
      </view>
      <view class="profile-sub">{{teacher.school || '点击设置任教学校'}} · 教师档案</view>
    </view>

    <view class="profile-edit-btn" bindtap="openEditPopup">
      <text>编辑</text>
      <t-icon name="chevron-right" size="32rpx" color="#8f959e" />
    </view>
  </view>

  <!-- 个人中心常用菜单列表 -->
  <view class="menu-section">
    <t-cell-group>
      <t-cell title="班级管理" note="{{classCountText || '点击管理或创建'}}" arrow hover bindtap="navToClassManage" />
      <t-cell title="我的任教课表" note="全周排课与日程" arrow hover bindtap="navToSchedule" />
      <t-cell title="课堂教学日志" note="授课笔记流水台账" arrow hover bindtap="navToLessonLogs" />
      <t-cell title="作息时间表" note="标准教学时段" arrow hover bindtap="navToPeriods" />
      <t-cell title="当前数据环境" note="{{currentEnv === 'prd' ? '生产环境 (prd)' : '开发环境 (dev)'}}" hover />
      <t-cell title="消息通知设置" arrow hover bindtap="onTapTip" data-text="通知设置" />
      <t-cell title="帮助与操作指引" arrow hover bindtap="onTapTip" data-text="帮助指引" />
      <t-cell title="关于系统" note="v0.10.0" arrow hover bindtap="onTapTip" data-text="智慧校园教师端" />
    </t-cell-group>
  </view>

  <!-- 测试环境专属数据重置操作区（仅开发测试环境展示） -->
  <view wx:if="{{currentEnv === 'dev'}}" class="dev-reset-section">
    <t-button theme="danger" variant="outline" size="large" block bindtap="confirmResetMyTestData">
      清空测试数据 (仅开发环境)
    </t-button>
  </view>

  <!-- 编辑个人资料弹出层 -->
  <t-popup visible="{{isEditPopupVisible}}" placement="bottom" bind:visible-change="onPopupVisibleChange">
    <view class="edit-popup-content">
      <view class="popup-header">
        <text class="popup-title">编辑教师资料</text>
        <view class="popup-close" bindtap="closeEditPopup">
          <t-icon name="close" size="36rpx" color="#8f959e" />
        </view>
      </view>

      <view class="edit-body">
        <!-- 头像更换 -->
        <view class="edit-avatar-section">
          <button class="avatar-button-wrap" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
            <t-avatar image="{{form.avatar_url || ''}}" icon="user" size="large" shape="round" />
            <view class="avatar-badge-edit">
              <t-icon name="camera" size="28rpx" color="#ffffff" />
            </view>
          </button>
          <text class="avatar-tip">点击获取微信头像或相册上传</text>
        </view>

        <!-- 姓名（支持微信昵称快捷选择） -->
        <view class="form-item">
          <text class="form-label">教师姓名 / 称呼 <text class="required">*</text></text>
          <view class="nickname-input-wrap">
            <input 
              type="nickname" 
              class="nickname-input" 
              placeholder="请输入姓名或点击键盘上方微信昵称" 
              value="{{form.name}}" 
              bindblur="onNicknameBlur"
              bindinput="onNameInput"
            />
          </view>
        </view>

        <!-- 任教学科快捷选择 -->
        <view class="form-item">
          <text class="form-label">任教学科</text>
          <view class="subject-tag-group">
            <view 
              wx:for="{{commonSubjects}}" 
              wx:key="*this" 
              class="subject-chip {{form.subject === item ? 'active' : ''}}"
              data-subject="{{item}}"
              bindtap="onSelectSubject"
            >
              {{item}}
            </view>
          </view>
        </view>

        <!-- 任教学校 -->
        <view class="form-item">
          <text class="form-label">学校名称</text>
          <view class="nickname-input-wrap">
            <input 
              class="nickname-input" 
              placeholder="请输入所在学校名称（选填）" 
              value="{{form.school}}" 
              bindinput="onSchoolInput"
            />
          </view>
        </view>
      </view>

      <!-- 底部提交按钮 -->
      <view class="popup-footer">
        <t-button theme="primary" size="large" block loading="{{isSaving}}" bindtap="saveProfile">
          保存修改
        </t-button>
      </view>
    </view>
  </t-popup>
</view>
