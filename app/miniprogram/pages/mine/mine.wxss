.mine-container {
  min-height: 100vh;
  background-color: var(--bg-color);
  padding: 32rpx 32rpx 48rpx;
  box-sizing: border-box;
}

.profile-card {
  display: flex;
  align-items: center;
  gap: 28rpx;
  background: linear-gradient(135deg, #EFF4FF 0%, var(--card-bg) 65%);
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(220, 233, 255, 0.6);
}

.avatar-wrap {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: #EEF2FF;
  display: flex;
  align-items: center;
  justify-content: center;
}

.user-meta {
  flex: 1;
}

.user-name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 8rpx;
}

.user-tip {
  display: block;
  font-size: 24rpx;
  color: var(--text-regular);
}

.stats-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: var(--card-bg);
  border-radius: 20rpx;
  padding: 24rpx 0;
  margin-bottom: 28rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--primary-color);
  margin-bottom: 4rpx;
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-regular);
}

.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background-color: var(--border-color);
}

.history-section {
  background: var(--card-bg);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 28rpx;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-main);
}

.section-more {
  font-size: 24rpx;
  color: var(--text-muted);
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}

.history-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.item-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.item-meta {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.item-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}

.item-time {
  font-size: 22rpx;
  color: var(--text-muted);
}

.menu-group {
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 40rpx;
}

.footer-note {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-muted);
}

/* tabbar 底部占位，防止内容被 tabbar 遮挡 */
.tabbar-placeholder {
  height: 140rpx;
}
