.container {
  min-height: 100vh;
  background-color: #F6F7FB;
  box-sizing: border-box;
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
}

.hero-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 48rpx 36rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  background: #ECF2FE;
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
  margin-bottom: 24rpx;
}

.hero-badge-text {
  font-size: 24rpx;
  color: #0052D9;
  font-weight: 500;
  margin-left: 8rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1D2129;
  line-height: 1.3;
  margin-bottom: 16rpx;
}

.hero-desc {
  font-size: 28rpx;
  color: #4E5969;
  line-height: 1.6;
}
