/** pages/index/index.wxss **/

.index-container {
  min-height: 100vh;
  padding: 24rpx 32rpx;
  background-color: var(--bg-color);
  box-sizing: border-box;
}

/* 1. 搜索框定制 */
.search-section {
  margin-bottom: 24rpx;
}

.custom-search {
  --td-search-bg-color: var(--card-bg) !important;
  --td-search-border-radius: 24rpx !important;
  box-shadow: 0 2rpx 10rpx rgba(15, 23, 42, 0.04);
}

/* 2. 常用工具横滑 */
.quick-tools-section {
  margin-bottom: 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.section-header .title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-main);
  letter-spacing: -0.5rpx;
}

.section-header .subtitle {
  font-size: 24rpx;
  color: var(--text-muted);
}

.quick-scroll {
  white-space: nowrap;
  width: 100%;
}

.quick-chips {
  display: flex;
  gap: 16rpx;
  padding: 4rpx 0;
}

.chip-item {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 28rpx;
  background-color: #EFF4FF;
  border: 1rpx solid #DCE9FF;
  border-radius: 100rpx;
  flex-shrink: 0;
}

.highlight-chip {
  background-color: #EEF2FF;
  border: 1.5rpx solid #C7D2FE;
}

.font-bold {
  font-weight: 700 !important;
  color: var(--primary-color) !important;
}

.chip-text {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-main);
}

/* 3. Bento 卡片网格 */
.category-section {
  margin-bottom: 32rpx;
}

.bento-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.bento-card {
  background-color: var(--card-bg);
  border-radius: 28rpx;
  padding: 28rpx;
  min-height: 250rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  border: 1rpx solid rgba(220, 233, 255, 0.6);
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.03);
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bg-blue { background-color: #EFF4FF; }
.bg-green { background-color: #ECFDF5; }
.bg-amber { background-color: #FFFBEB; }
.bg-purple { background-color: #F5F3FF; }
.bg-cyan { background-color: #ECFEFF; }
.bg-rose { background-color: #FFF1F2; }

.card-bottom {
  display: flex;
  flex-direction: column;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-main);
  letter-spacing: -0.5rpx;
}

.card-desc {
  font-size: 22rpx;
  color: var(--text-regular);
  margin-top: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 4. AI 助手 Banner */
.ai-banner {
  background: linear-gradient(135deg, #EFF4FF 0%, var(--card-bg) 50%, #E5EEFF 100%);
  border: 1rpx solid rgba(0, 81, 213, 0.15);
  border-radius: 28rpx;
  padding: 26rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.ai-content {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  min-width: 0;
}

.ai-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(0, 40, 142, 0.25);
}

.ai-text {
  flex: 1;
  min-width: 0;
}

.ai-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.ai-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-main);
}

.ai-desc {
  font-size: 22rpx;
  color: var(--text-regular);
  margin-top: 4rpx;
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.ai-action {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 10rpx 20rpx;
  background-color: #DCE9FF;
  border-radius: 100rpx;
  flex-shrink: 0;
}

.ai-action .btn-text {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--primary-color);
}

/* 5. 底部占位 */
.tabbar-placeholder {
  height: 140rpx;
}
