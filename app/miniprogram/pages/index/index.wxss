.page-container {
  padding: 40rpx 48rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* Header */
.header {
  margin-top: 40rpx;
  margin-bottom: 80rpx;
  display: flex;
  flex-direction: column;
}

.greeting {
  font-size: 32rpx;
  color: var(--secondary-color);
  margin-bottom: 8rpx;
}

.user-name {
  font-size: 56rpx;
  font-weight: 500;
  color: var(--primary-color);
  letter-spacing: 2rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--primary-color);
  margin-bottom: 40rpx;
}

/* Books Grid */
.books-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 60rpx 40rpx;
}

.book-card {
  display: flex;
  flex-direction: column;
}

.book-card:active {
  opacity: 0.8;
  transform: scale(0.98);
  transition: all 0.2s ease;
}

.book-cover {
  width: 100%;
  aspect-ratio: 2 / 3;
  border-radius: 8rpx;
  box-shadow: 2rpx 4rpx 16rpx rgba(0, 0, 0, 0.04), 0 1rpx 2rpx rgba(0,0,0,0.06);
  padding: 32rpx 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
  margin-bottom: 24rpx;
}

/* Simulate the book spine texture on the left edge */
.book-cover::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 12rpx;
  background: linear-gradient(to right, rgba(255,255,255,0.4) 0%, rgba(0,0,0,0.05) 100%);
  border-right: 1rpx solid rgba(0,0,0,0.05);
}

.cover-tag {
  align-self: flex-start;
  font-size: 20rpx;
  color: rgba(0, 0, 0, 0.5);
  border: 1rpx solid rgba(0, 0, 0, 0.2);
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  margin-bottom: 16rpx;
}

.cover-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1A1A1A;
  line-height: 1.4;
  margin-bottom: auto;
  writing-mode: vertical-rl;
  letter-spacing: 4rpx;
  align-self: center;
  margin-top: 20rpx;
}

.cover-author {
  font-size: 22rpx;
  color: rgba(0, 0, 0, 0.6);
  align-self: flex-end;
}

.book-info {
  display: flex;
  flex-direction: column;
  padding: 0 4rpx;
}

.book-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--primary-color);
  margin-bottom: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.book-progress {
  font-size: 22rpx;
  color: var(--secondary-color);
}
