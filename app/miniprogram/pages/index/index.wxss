/* pages/index/index.wxss */
page {
  background-color: #f7f8fa;
  min-height: 100vh;
  box-sizing: border-box;
}

.index-page {
  padding: 24rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* ================= 1. 正在上课主卡片 ================= */
.lesson-section {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
}

.live-lesson-card {
  background: linear-gradient(135deg, #eef2ff 0%, #e0e7ff 100%);
  border: 1.5rpx solid #c7d2fe;
  border-radius: 24rpx 24rpx 0 0;
  padding: 28rpx 28rpx 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(79, 70, 229, 0.08);
  box-sizing: border-box;
}

/* 顶部状态与进度行 */
.live-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  gap: 12rpx;
}

.live-status-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* 呼吸脉冲圆点 */
.pulse-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background-color: #0052d9;
  box-shadow: 0 0 0 6rpx rgba(0, 82, 217, 0.2);
  animation: livePulse 1.8s ease-in-out infinite;
}

@keyframes livePulse {
  0% {
    box-shadow: 0 0 0 0 rgba(0, 82, 217, 0.5);
  }
  70% {
    box-shadow: 0 0 0 12rpx rgba(0, 82, 217, 0);
  }
  100% {
    box-shadow: 0 0 0 0 rgba(0, 82, 217, 0);
  }
}

.live-status-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #0052d9;
}

.remain-time-badge {
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid #c7d2fe;
  border-radius: 40rpx;
  padding: 4rpx 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #0036b3;
}

.live-status-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #0052d9;
}

.period-time-range {
  font-weight: 500;
}

.progress-pct-text {
  font-weight: 700;
  color: #0052d9;
}

/* 课程主标题 */
.live-title-row {
  margin: 12rpx 0 18rpx;
}

.live-lesson-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #111827;
  letter-spacing: 0.5rpx;
}

/* 进度条轨道与填充 */
.progress-bar-track {
  height: 8rpx;
  background-color: rgba(0, 82, 217, 0.15);
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #0052d9, #2563eb);
  border-radius: 6rpx;
  transition: width 0.4s ease;
}

/* 双操作按钮栏 */
.live-actions-row {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  flex: 1;
  height: 76rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-sizing: border-box;
  transition: all 0.15s ease;
}

.btn-record-lesson {
  background: #ffffff;
  border: 1.5rpx solid #0052d9;
  color: #0052d9;
}

.btn-record-lesson.is-recorded {
  background: #e8f8f2;
  border: 1.5rpx solid #a3e6cb;
  color: #00a870;
}

.btn-quick-note {
  background-color: #0052d9;
  border: 1.5rpx solid #0052d9;
  color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(0, 82, 217, 0.25);
}

.action-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}

/* ================= 次级提示卡片 ================= */
.status-banner-card {
  background: #ffffff;
  border: 1rpx solid #e5e6eb;
  padding: 22rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  box-sizing: border-box;
}

.status-banner-card.attached-bottom {
  border-radius: 0 0 24rpx 24rpx;
  border-top: 1rpx dashed #dbeafe;
  background-color: #f8fafc;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.status-banner-card.standalone {
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.status-main-content {
  flex: 1;
  min-width: 0;
}

.status-desc-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #1d2129;
}

.status-text-row {
  font-size: 28rpx;
}

.status-prefix-text {
  color: #86909c;
}

.status-highlight-text {
  font-weight: 600;
  color: #1d2129;
}

.next-lesson-prefix {
  font-size: 22rpx;
  color: #86909c;
  margin-bottom: 4rpx;
}

.next-lesson-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1d2129;
  margin-bottom: 4rpx;
}

.next-lesson-time {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #86909c;
}

.status-actions-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.mini-action-btn {
  padding: 12rpx 22rpx;
  border-radius: 12rpx;
  border: 1rpx solid #c7d2fe;
  background: #ffffff;
  color: #0052d9;
  font-size: 24rpx;
  font-weight: 500;
}

.mini-primary-btn {
  padding: 12rpx 22rpx;
  border-radius: 12rpx;
  background: #0052d9;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.mini-action-btn:active,
.mini-primary-btn:active {
  transform: scale(0.96);
}

/* ================= 3. 今日课堂笔记卡片 ================= */
.notes-section-card {
  background: #ffffff;
  border-radius: 24rpx;
  border: 1rpx solid #e5e6eb;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.notes-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.notes-title-group {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.notes-icon-box {
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
  background-color: #ecf2fe;
  display: flex;
  align-items: center;
  justify-content: center;
}

.notes-main-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1d2129;
}

.notes-count-badge {
  background-color: #ecf2fe;
  color: #0052d9;
  border-radius: 30rpx;
  padding: 2rpx 16rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.notes-all-link {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 26rpx;
  color: #0052d9;
  font-weight: 500;
}

.notes-list-wrap {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.note-item-card {
  background-color: #f8fafc;
  border: 1rpx solid #edf2f7;
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
  transition: all 0.15s ease;
}

.note-item-card:active {
  background-color: #f1f5f9;
}

.note-item-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.note-tag {
  background-color: #ecf2fe;
  color: #0052d9;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.note-edit-action {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: #0052d9;
  font-weight: 500;
}

.note-content-body {
  font-size: 28rpx;
  color: #1d2129;
  line-height: 1.5;
}

.notes-empty-wrap {
  padding: 40rpx 0;
  text-align: center;
}

.notes-empty-desc {
  font-size: 26rpx;
  color: #86909c;
}

/* ================= 4. 抽屉弹窗样式 ================= */
.modal-wrapper {
  background-color: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}

.modal-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.modal-title-group {
  display: flex;
  flex-direction: column;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1d2129;
  margin-bottom: 6rpx;
}

.modal-subtitle {
  font-size: 24rpx;
  color: #86909c;
}

.modal-close-btn {
  padding: 8rpx;
}

.quick-tags-row {
  margin-bottom: 20rpx;
}

.quick-tags-label {
  font-size: 24rpx;
  color: #86909c;
  display: block;
  margin-bottom: 12rpx;
}

.quick-tag-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.quick-pill {
  background-color: #f2f3f5;
  color: #4e5969;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
}

.quick-pill:active {
  background-color: #ecf2fe;
  color: #0052d9;
}

.textarea-wrap {
  background-color: #f7f8fa;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 32rpx;
}

.record-textarea {
  width: 100%;
  height: 200rpx;
  font-size: 28rpx;
  color: #1d2129;
  line-height: 1.5;
}

.modal-btns-row {
  display: flex;
  gap: 16rpx;
}
