/* pages/index/index.wxss */
page {
  background-color: #f6f7fb;
  min-height: 100vh;
}

.index-container {
  padding: 30rpx 24rpx;
}

.header-banner {
  background: linear-gradient(135deg, #0052d9 0%, #2b77f5 100%);
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  color: #ffffff;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 82, 217, 0.2);
}

.welcome-title {
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.welcome-sub {
  font-size: 26rpx;
  opacity: 0.85;
  margin-top: 10rpx;
}

.placeholder-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 80rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
