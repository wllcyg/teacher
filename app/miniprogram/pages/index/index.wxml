<!--pages/index/index.wxml-->
<view class="index-page">
  <!-- 1. 主视觉：正在上课卡片 + 状态条 -->
  <view class="lesson-section">
    <!-- 场景 A：当前正在上课 -->
    <view class="live-lesson-card" wx:if="{{currentLesson && currentPeriod}}">
      <!-- 顶部：状态徽标与时间进度 -->
      <view class="live-header-row">
        <view class="live-status-left">
          <view class="pulse-dot"></view>
          <text class="live-status-title">正在上课</text>
          <view class="remain-time-badge">
            <text>还剩 {{remainMinutes}} 分钟</text>
          </view>
        </view>

        <view class="live-status-right">
          <t-icon name="time" size="26rpx" color="#0052d9" />
          <text class="period-time-range">{{currentPeriod.time}}</text>
          <text class="progress-pct-text">{{progressPct}}%</text>
        </view>
      </view>

      <!-- 课程主标题 -->
      <view class="live-title-row">
        <text class="live-lesson-title">第{{currentLesson.period_n}}节 {{currentLesson.class_name}}·{{currentLesson.subject}}</text>
      </view>

      <!-- 动态平滑进度条 -->
      <view class="progress-bar-track">
        <view class="progress-bar-fill" style="width: {{progressPct}}%;"></view>
      </view>

      <!-- 底部双操作按钮 -->
      <view class="live-actions-row">
        <view 
          class="action-btn btn-record-lesson {{isCurrentLessonRecorded ? 'is-recorded' : ''}}"
          bindtap="openRecordModal"
          data-lesson="{{currentLesson}}"
        >
          <t-icon name="book" size="30rpx" color="{{isCurrentLessonRecorded ? '#00a870' : '#0052d9'}}" />
          <text>{{isCurrentLessonRecorded ? '已记课堂' : '记课堂'}}</text>
        </view>

        <view 
          class="action-btn btn-quick-note"
          bindtap="openQuickNoteModal"
          data-lesson="{{currentLesson}}"
        >
          <t-icon name="edit" size="30rpx" color="#ffffff" />
          <text>记一笔</text>
        </view>
      </view>
    </view>

    <!-- 次级状态卡片：下一节 / 最后一节 / 已上完 -->
    <view class="status-banner-card {{currentLesson ? 'attached-bottom' : 'standalone'}}">
      <view class="status-main-content">
        <!-- 如果不在上课且有下一节 -->
        <block wx:if="{{!currentLesson && nextLesson && nextPeriod}}">
          <view class="next-lesson-prefix">下一节</view>
          <view class="next-lesson-title">
            第{{nextLesson.period_n}}节 {{nextLesson.class_name}}·{{nextLesson.subject}}
          </view>
          <view class="next-lesson-time">
            <t-icon name="time" size="24rpx" color="#86909c" />
            <text>{{nextPeriod.time}}</text>
          </view>
        </block>

        <!-- 如果正在上课但有接下来的一节 -->
        <block wx:elif="{{currentLesson && nextLesson && nextPeriod}}">
          <view class="status-text-row">
            <text class="status-prefix-text">接下来：</text>
            <text class="status-highlight-text">第{{nextLesson.period_n}}节 {{nextLesson.class_name}}·{{nextLesson.subject}} ({{nextPeriod.time}})</text>
          </view>
        </block>

        <!-- 其余状态文案（如：这是今天最后一节课了 / 今天的课上完了 / 今天没有排课） -->
        <block wx:else>
          <view class="status-desc-text">{{dayStatusText}}</view>
        </block>
      </view>

      <!-- 不在上课时的右侧快捷按钮 -->
      <view class="status-actions-right" wx:if="{{!currentLesson && todayLessons.length > 0}}">
        <view 
          class="mini-action-btn"
          wx:if="{{lastLesson}}"
          bindtap="openRecordModal"
          data-lesson="{{lastLesson}}"
        >
          <text>{{isLastLessonRecorded ? '已记第' + lastLesson.period_n + '节' : '补记第' + lastLesson.period_n + '节'}}</text>
        </view>
        <view 
          class="mini-primary-btn"
          bindtap="openQuickNoteModal"
          data-lesson="{{nextLesson}}"
        >
          <t-icon name="edit" size="24rpx" color="#ffffff" />
          <text>记一笔</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 3. 今日课堂笔记清单卡片 -->
  <view class="notes-section-card">
    <view class="notes-header-row">
      <view class="notes-title-group">
        <view class="notes-icon-box">
          <t-icon name="book" size="32rpx" color="#0052d9" />
        </view>
        <text class="notes-main-title">今日课堂笔记</text>
        <view class="notes-count-badge" wx:if="{{todayLogs.length > 0}}">
          <text>{{todayLogs.length}} 条已记</text>
        </view>
      </view>

      <view class="notes-all-link" bindtap="navToLessonLogs">
        <text>全部记录</text>
        <t-icon name="chevron-right" size="28rpx" color="#0052d9" />
      </view>
    </view>

    <!-- 笔记列表 -->
    <view class="notes-list-wrap" wx:if="{{todayLogs.length > 0}}">
      <view 
        class="note-item-card" 
        wx:for="{{todayLogs}}" 
        wx:key="id"
        bindtap="onEditLogItem"
        data-log="{{item}}"
      >
        <view class="note-item-header">
          <view class="note-tag">
            <text>{{item.period_str}} · {{item.class_name}}{{item.subject ? ' · ' + item.subject : ''}}</text>
          </view>
          <view class="note-edit-action">
            <t-icon name="edit" size="26rpx" color="#0052d9" />
            <text>编辑</text>
          </view>
        </view>
        <view class="note-content-body">
          <text>{{item.content}}</text>
        </view>
      </view>
    </view>

    <!-- 空笔记提示 -->
    <view class="notes-empty-wrap" wx:else>
      <text class="notes-empty-desc">今天还没有记录课堂笔记，上完课随手记一笔吧~</text>
    </view>
  </view>

  <!-- 4. 抽屉弹窗：记课堂 / 编辑课堂记录 -->
  <t-popup visible="{{isRecordModalVisible}}" placement="bottom" bind:visible-change="onRecordModalVisibleChange">
    <view class="modal-wrapper">
      <view class="modal-header">
        <view class="modal-title-group">
          <text class="modal-title">{{editingLogId ? '编辑课堂记录' : '记课堂'}}</text>
          <text class="modal-subtitle" wx:if="{{activeModalLesson}}">
            {{activeModalLesson.period_str || ('第' + activeModalLesson.period_n + '节')}} · {{activeModalLesson.class_name}} · {{activeModalLesson.subject || '地理'}}
          </text>
        </view>
        <view class="modal-close-btn" bindtap="closeRecordModal">
          <t-icon name="close" size="36rpx" color="#8f959e" />
        </view>
      </view>

      <view class="modal-body">
        <!-- 快捷短语标签 -->
        <view class="quick-tags-row">
          <text class="quick-tags-label">快捷填充：</text>
          <view class="quick-tag-pills">
            <view 
              class="quick-pill" 
              wx:for="{{quickPhrases}}" 
              wx:key="*this"
              bindtap="onSelectQuickPhrase"
              data-text="{{item}}"
            >
              <text>{{item}}</text>
            </view>
          </view>
        </view>

        <!-- 课堂内容输入框 -->
        <view class="textarea-wrap">
          <textarea 
            class="record-textarea" 
            placeholder="记录讲课章节、过关背诵要求或作业（如：讲第一章第三节，背诵课本3~6页）" 
            maxlength="500"
            value="{{recordContent}}"
            bindinput="onInputRecordContent"
          />
        </view>
      </view>

      <view class="modal-footer">
        <view class="modal-btns-row">
          <t-button 
            wx:if="{{editingLogId}}" 
            theme="danger" 
            variant="outline" 
            size="large" 
            style="flex: 1;"
            bindtap="deleteRecord"
          >
            删除
          </t-button>
          <t-button 
            theme="primary" 
            size="large" 
            style="flex: 2;"
            loading="{{isSavingRecord}}"
            disabled="{{!recordContent}}"
            bindtap="saveRecord"
          >
            保存记录
          </t-button>
        </view>
      </view>
    </view>
  </t-popup>

  <!-- 5. 抽屉弹窗：快速记一笔 -->
  <t-popup visible="{{isQuickNoteModalVisible}}" placement="bottom" bind:visible-change="onQuickNoteVisibleChange">
    <view class="modal-wrapper">
      <view class="modal-header">
        <view class="modal-title-group">
          <text class="modal-title">随堂记一笔</text>
          <text class="modal-subtitle">快速捕捉课堂灵感、纪律情况或待办备忘</text>
        </view>
        <view class="modal-close-btn" bindtap="closeQuickNoteModal">
          <t-icon name="close" size="36rpx" color="#8f959e" />
        </view>
      </view>

      <view class="modal-body">
        <view class="textarea-wrap">
          <textarea 
            class="record-textarea" 
            placeholder="随手记下学生表现、需要跟进的事情或提醒..." 
            maxlength="300"
            value="{{quickNoteText}}"
            bindinput="onInputQuickNoteText"
          />
        </view>
      </view>

      <view class="modal-footer">
        <t-button 
          theme="primary" 
          size="large" 
          block
          loading="{{isSavingQuickNote}}"
          disabled="{{!quickNoteText}}"
          bindtap="saveQuickNote"
        >
          存入课堂笔记
        </t-button>
      </view>
    </view>
  </t-popup>
</view>