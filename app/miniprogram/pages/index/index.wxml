<view class="page-container">
  <!-- Header -->
  <view class="header">
    <text class="greeting">{{greeting}}</text>
    <text class="user-name">{{userName}}</text>
  </view>

  <view class="section-title">正在阅读</view>

  <!-- Books Grid -->
  <view class="books-grid">
    <block wx:for="{{recentBooks}}" wx:key="id">
      <view class="book-card" bindtap="onBookTap" data-id="{{item.id}}">
        <view class="book-cover" style="background-color: {{item.coverColor}}">
          <!-- Text-based cover for elegance -->
          <view class="cover-tag">{{item.tag}}</view>
          <view class="cover-title">{{item.title}}</view>
          <view class="cover-author">{{item.author}}</view>
        </view>
        <view class="book-info">
          <text class="book-title">{{item.title}}</text>
          <text class="book-progress">{{item.progress}}</text>
        </view>
      </view>
    </block>
  </view>
</view>
