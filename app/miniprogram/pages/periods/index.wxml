<!--pages/periods/index.wxml-->
<view class="periods-container">
  <!-- 顶部实时时钟与作息概览看板 -->
  <view class="time-board-card">
    <view class="board-left">
      <text class="board-label">当前校准时间</text>
      <text class="board-clock">{{currentTimeStr || '--:--:--'}}</text>
    </view>
    <view class="board-right">
      <view class="board-overview-badge">
        <t-icon name="view-module" size="28rpx" color="#ffffff" />
        <text class="badge-text">全日共 {{periods.length}} 节课</text>
      </view>
    </view>
  </view>

  <!-- 操作指引提示条 -->
  <view class="tip-bar">
    <t-icon name="info-circle" size="30rpx" color="#0052d9" />
    <text class="tip-text">点击时间段可微调时间；向左滑动可删除</text>
  </view>

  <!-- 平铺时间段列表卡片 -->
  <view class="periods-main-card">
    <!-- 列表有数据时 -->
    <view class="period-list" wx:if="{{periods.length > 0}}">
      <block wx:for="{{periods}}" wx:key="id">
        <t-swipe-cell class="period-swipe-cell">
          <!-- 默认正文行项 -->
          <view 
            class="period-row"
            bindtap="openEditModal"
            data-item="{{item}}"
          >
            <view class="row-left">
              <view class="period-num">
                {{item.n}}
              </view>
              <view class="period-info">
                <text class="period-name">第 {{item.n}} 节课</text>
                <text class="period-time">{{item.start}} - {{item.end}}</text>
              </view>
            </view>

            <view class="row-right">
              <view class="normal-duration">
                <text class="duration-num">{{item.duration}}</text>
                <text class="duration-unit">分钟</text>
                <t-icon name="chevron-right" size="28rpx" color="#c9cdd4" />
              </view>
            </view>
          </view>

          <!-- 左滑出的红色删除操作按钮 -->
          <view 
            slot="right" 
            class="swipe-delete-action" 
            catchtap="onDeletePeriod" 
            data-item="{{item}}"
          >
            <t-icon name="delete" size="36rpx" color="#ffffff" />
            <text class="delete-action-text">删除</text>
          </view>
        </t-swipe-cell>
      </block>
    </view>

    <!-- 缺省空状态 -->
    <view class="empty-wrap" wx:else>
      <t-icon name="time" size="80rpx" color="#c9cdd4" />
      <text class="empty-title">暂无配置作息时间段</text>
      <text class="empty-sub">点击下方「添加时间段」或一键恢复标准作息</text>
    </view>
  </view>

  <!-- 底部操作按钮区域 -->
  <view class="footer-actions">
    <t-button 
      theme="primary" 
      size="large" 
      block 
      icon="add" 
      bindtap="openAddModal"
      class="add-period-btn"
    >
      添加时间段
    </t-button>

    <view class="reset-link-wrap">
      <t-button 
        theme="default" 
        variant="text" 
        icon="refresh" 
        size="medium" 
        bindtap="confirmResetDefault"
      >
        恢复标准作息（11节）
      </t-button>
    </view>
  </view>

  <!-- 弹窗抽屉（支持新建与微调编辑） -->
  <t-popup visible="{{isModalVisible}}" placement="bottom" bind:visible-change="onModalVisibleChange">
    <view class="modal-content">
      <view class="modal-header">
        <view class="modal-title-wrap">
          <text class="modal-title">{{modalType === 'add' ? '添加新作息时间段' : '微调第 ' + editingPeriod.n + ' 节课作息'}}</text>
          <text class="modal-subtitle">使用原生滚轮精准点选开始与结束时间</text>
        </view>
        <view class="modal-close" bindtap="closeModal">
          <t-icon name="close" size="36rpx" color="#8f959e" />
        </view>
      </view>

      <view class="modal-body">
        <!-- 开始时间 -->
        <view class="time-picker-row">
          <text class="picker-label">上课开始时间</text>
          <picker mode="time" value="{{editForm.start}}" bindchange="onStartTimeChange">
            <view class="picker-slot">
              <text class="picker-time-val">{{editForm.start}}</text>
              <t-icon name="chevron-right" size="28rpx" color="#8f959e" />
            </view>
          </picker>
        </view>

        <!-- 结束时间 -->
        <view class="time-picker-row">
          <text class="picker-label">下课结束时间</text>
          <picker mode="time" value="{{editForm.end}}" bindchange="onEndTimeChange">
            <view class="picker-slot">
              <text class="picker-time-val">{{editForm.end}}</text>
              <t-icon name="chevron-right" size="28rpx" color="#8f959e" />
            </view>
          </picker>
        </view>

        <!-- 课程时长推算提示 -->
        <view class="duration-preview-card">
          <t-icon name="time" size="32rpx" color="#0052d9" />
          <text class="duration-preview-text">预计单节课时长：<text class="bold-text">{{computedDuration}} 分钟</text></text>
        </view>
      </view>

      <view class="modal-footer">
        <t-button theme="primary" size="large" block bindtap="savePeriodModal">
          {{modalType === 'add' ? '确认添加' : '保存修改'}}
        </t-button>
      </view>
    </view>
  </t-popup>
</view>
