/* pages/periods/index.wxss */
page {
  background-color: #f7f8fa;
  min-height: 100vh;
  box-sizing: border-box;
}

.periods-container {
  padding: 24rpx;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* 顶部时钟与作息概览看板 */
.time-board-card {
  background: linear-gradient(135deg, #0052d9 0%, #1e6ceb 100%);
  border-radius: 20rpx;
  padding: 32rpx;
  color: #ffffff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 82, 217, 0.2);
  margin-bottom: 20rpx;
}

.board-left {
  display: flex;
  flex-direction: column;
}

.board-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 8rpx;
}

.board-clock {
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
}

.board-right {
  display: flex;
  align-items: center;
}

.board-overview-badge {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 22rpx;
  border-radius: 32rpx;
  background-color: rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(8px);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 500;
  border: 1rpx solid rgba(255, 255, 255, 0.25);
}

.badge-text {
  letter-spacing: 0.5rpx;
}

/* 提示条 */
.tip-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  background-color: #ecf2fe;
  border-radius: 14rpx;
  margin-bottom: 24rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #0052d9;
  font-weight: 400;
}

/* 平铺列表大卡片 */
.periods-main-card {
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  margin-bottom: 32rpx;
}

.period-list {
  display: flex;
  flex-direction: column;
}

/* 滑动单元格与内部行项 */
.period-swipe-cell {
  width: 100%;
  display: block;
  border-bottom: 1rpx solid #f2f3f5;
}

.period-swipe-cell:last-child {
  border-bottom: none;
}

.period-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 26rpx 24rpx;
  background-color: #ffffff;
  transition: background-color 0.2s ease;
  width: 100%;
  box-sizing: border-box;
}

.period-row:active {
  background-color: #f7f8fa;
}

.row-left {
  display: flex;
  align-items: center;
}

.period-num {
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
  background-color: #f2f3f5;
  color: #4e5969;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 22rpx;
}

.period-info {
  display: flex;
  flex-direction: column;
}

.period-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1d2129;
  margin-bottom: 6rpx;
}

.period-time {
  font-size: 25rpx;
  color: #86909c;
}

.row-right {
  display: flex;
  align-items: center;
}

.normal-duration {
  display: inline-flex;
  align-items: center;
  font-size: 25rpx;
  color: #86909c;
}

.duration-num {
  font-weight: 600;
  color: #4e5969;
  margin-right: 4rpx;
}

.duration-unit {
  margin-right: 8rpx;
}

/* 左滑删除操作按钮 */
.swipe-delete-action {
  width: 150rpx;
  height: 100%;
  background-color: #e34d59;
  color: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.delete-action-text {
  font-size: 24rpx;
  font-weight: 500;
  color: #ffffff;
}

/* 缺省空状态 */
.empty-wrap {
  padding: 80rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #4e5969;
  margin-top: 12rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: #86909c;
  text-align: center;
}

/* 底部操作区 */
.footer-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  margin-top: 12rpx;
}

.add-period-btn {
  width: 100%;
}

.reset-link-wrap {
  display: flex;
  justify-content: center;
}

/* 弹窗抽屉 */
.modal-content {
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 32rpx;
}

.modal-title-wrap {
  display: flex;
  flex-direction: column;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1d2129;
  line-height: 1.3;
}

.modal-subtitle {
  font-size: 24rpx;
  color: #86909c;
  margin-top: 8rpx;
}

.modal-close {
  padding: 8rpx;
}

.modal-body {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-bottom: 40rpx;
}

.time-picker-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
  background-color: #f7f8fa;
  border-radius: 16rpx;
  border: 1rpx solid #e5e6eb;
}

.picker-label {
  font-size: 28rpx;
  color: #4e5969;
  font-weight: 500;
}

.picker-slot {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.picker-time-val {
  font-size: 32rpx;
  font-weight: 600;
  color: #1d2129;
}

.duration-preview-card {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  background-color: #f2f7ff;
  border-radius: 14rpx;
  color: #0052d9;
  font-size: 26rpx;
}

.bold-text {
  font-weight: 700;
  font-size: 28rpx;
}

.modal-footer {
  width: 100%;
}
