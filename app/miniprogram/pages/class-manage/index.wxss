/* pages/class-manage/index.wxss */
page {
  background-color: #f6f7fb;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  color: #1d2129;
}

.manage-container {
  padding: 24rpx;
}

/* 顶部操作条 */
.top-action-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 8rpx 4rpx;
}

.bar-left {
  display: flex;
  flex-direction: column;
}

.bar-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1d2129;
  letter-spacing: 0.5rpx;
}

.bar-desc {
  font-size: 24rpx;
  color: #86909c;
  margin-top: 6rpx;
}

/* 班级卡片列表 */
.class-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.class-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 28rpx 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(0, 0, 0, 0.03);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.class-card:active {
  transform: scale(0.995);
}

/* 卡片头部 */
.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f2f3f5;
}

.class-title-wrap {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  flex: 1;
}

.class-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1d2129;
}

.class-headmaster {
  font-size: 22rpx;
  color: #0052d9;
  background: #f0f5ff;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

/* 卡片数据主体 */
.card-body {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 24rpx 0;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-val {
  font-size: 38rpx;
  font-weight: 700;
  color: #1d2129;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

.stat-lbl {
  font-size: 24rpx;
  color: #86909c;
  margin-top: 6rpx;
}

.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: #e5e6eb;
}

/* 卡片底部操作栏 */
.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 18rpx;
  border-top: 1rpx solid #f2f3f5;
}

.roster-entry-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  border-radius: 12rpx;
  background: #f0f5ff;
  min-height: 56rpx;
  transition: opacity 0.2s ease;
}

.roster-entry-btn:active {
  opacity: 0.8;
}

.roster-btn-text {
  font-size: 24rpx;
  color: #0052d9;
  font-weight: 600;
}

.right-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: #4e5969;
  padding: 10rpx 18rpx;
  border-radius: 10rpx;
  background: #f7f8fa;
  min-height: 56rpx;
}

.action-btn:active {
  background: #ebedf0;
}

.delete-btn {
  color: #e34d59;
  background: #fff0f0;
}

.delete-btn:active {
  background: #ffe3e3;
}

/* 空状态 */
.empty-wrap {
  padding: 100rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

/* 底部抽屉弹窗 */
.modal-content {
  background: #ffffff;
  border-top-left-radius: 28rpx;
  border-top-right-radius: 28rpx;
  padding: 32rpx 32rpx 48rpx;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f2f3f5;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1d2129;
}

.modal-close {
  padding: 8rpx;
}

.modal-body {
  padding: 24rpx 0;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.form-row {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.form-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #333842;
}

.required {
  color: #e34d59;
}

.input-box {
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 0 24rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid #e5e6eb;
  box-sizing: border-box;
}

.inner-input {
  font-size: 28rpx;
  color: #1d2129;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
}

.picker-box {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 0 24rpx;
  height: 88rpx;
  border: 1rpx solid #e5e6eb;
  box-sizing: border-box;
}

.picker-value {
  font-size: 28rpx;
  color: #1d2129;
  font-weight: 500;
  line-height: 1;
}

.picker-value.placeholder {
  color: #8f959e;
  font-weight: normal;
}

/* 年级选择 Chip 样式 */
.grade-chip-group {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.grade-chip {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: #4e5969;
  background: #f2f3f5;
  border-radius: 12rpx;
  border: 1rpx solid transparent;
  transition: all 0.2s ease;
}

.grade-chip.active {
  color: #0052d9;
  background: #ecf2fe;
  border-color: #0052d9;
  font-weight: 600;
}

.modal-footer {
  margin-top: 16rpx;
}

/* 底部常驻悬浮栏 */
.bottom-fixed-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.94);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
}
