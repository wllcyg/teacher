<!--pages/class-manage/index.wxml-->
<view class="manage-container">
  <!-- 顶部统计栏 -->
  <view class="top-action-bar">
    <view class="bar-left">
      <text class="bar-title">我管理的班级</text>
      <text class="bar-desc">共 {{classList.length}} 个班级空间</text>
    </view>
  </view>

  <!-- 班级列表 -->
  <view class="class-list" wx:if="{{classList.length > 0}}">
    <view class="class-card" wx:for="{{classList}}" wx:key="id">
      <view class="card-header">
        <view class="class-title-wrap">
          <text class="class-name">{{item.name}}</text>
          <t-tag theme="primary" variant="light" size="small">{{item.grade}}</t-tag>
        </view>
        <view class="class-headmaster">班主任</view>
      </view>

      <view class="card-body" bindtap="navToStudentRoster" data-id="{{item.id}}" data-name="{{item.name}}">
        <view class="stat-item">
          <text class="stat-val">{{item.student_count || 0}}</text>
          <text class="stat-lbl">学生人数</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-val">{{item.academic_year || '2024-2025'}}</text>
          <text class="stat-lbl">学年周期</text>
        </view>
      </view>

      <view class="card-footer">
        <view class="roster-entry-btn" bindtap="navToStudentRoster" data-id="{{item.id}}" data-name="{{item.name}}">
          <t-icon name="usergroup" size="32rpx" color="#0052d9" />
          <text class="roster-btn-text">学生花名册</text>
          <t-icon name="chevron-right" size="28rpx" color="#0052d9" />
        </view>

        <view class="right-actions">
          <view class="action-btn" bindtap="openEditModal" data-item="{{item}}">
            <t-icon name="edit" size="32rpx" color="#4e5969" />
            <text>编辑</text>
          </view>
          <view class="action-btn delete-btn" bindtap="confirmDeleteClass" data-id="{{item.id}}" data-name="{{item.name}}">
            <t-icon name="delete" size="32rpx" color="#e34d59" />
            <text>解散</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-wrap" wx:elif="{{!isLoading}}">
    <t-empty icon="info-circle" description="尚未创建任何班级空间，点击底部按钮创建" />
  </view>

  <!-- 底部固定唯一定位创建按钮 -->
  <view class="bottom-fixed-bar">
    <t-button theme="primary" size="large" block icon="add" bindtap="openCreateModal">
      创建新班级
    </t-button>
  </view>

  <!-- 创建/编辑班级弹出层 -->
  <t-popup visible="{{isModalVisible}}" placement="bottom" bind:visible-change="onModalVisibleChange">
    <view class="modal-content">
      <view class="modal-header">
        <text class="modal-title">{{isEditing ? '编辑班级信息' : '创建新班级'}}</text>
        <view class="modal-close" bindtap="closeModal">
          <t-icon name="close" size="36rpx" color="#8f959e" />
        </view>
      </view>

      <view class="modal-body">
        <!-- 班级名称 -->
        <view class="form-row">
          <text class="form-title">班级名称 <text class="required">*</text></text>
          <view class="input-box">
            <input 
              class="inner-input" 
              placeholder="例如：八年级三班、初二(3)班" 
              value="{{form.name}}" 
              bindinput="onInputName" 
            />
          </view>
        </view>

        <!-- 所属年级快捷选择 -->
        <view class="form-row">
          <text class="form-title">所属年级 <text class="required">*</text></text>
          <view class="grade-chip-group">
            <view 
              wx:for="{{gradeOptions}}" 
              wx:key="*this" 
              class="grade-chip {{form.grade === item ? 'active' : ''}}"
              data-grade="{{item}}"
              bindtap="onSelectGrade"
            >
              {{item}}
            </view>
          </view>
        </view>

        <!-- 学年周期时间选择组件 -->
        <view class="form-row">
          <text class="form-title">学年周期 <text class="required">*</text></text>
          <picker 
            mode="selector" 
            range="{{academicYearOptions}}" 
            value="{{academicYearIndex}}" 
            bindchange="onAcademicYearChange"
          >
            <view class="picker-box">
              <view class="picker-value {{form.academic_year ? '' : 'placeholder'}}">
                {{form.academic_year ? form.academic_year + ' 学年' : '请选择学年周期'}}
              </view>
              <t-icon name="chevron-right" size="32rpx" color="#8f959e" />
            </view>
          </picker>
        </view>
      </view>

      <!-- 底部提交按钮 -->
      <view class="modal-footer">
        <t-button theme="primary" size="large" block loading="{{isSubmitting}}" bindtap="submitClassForm">
          {{isEditing ? '保存修改' : '确认创建'}}
        </t-button>
      </view>
    </view>
  </t-popup>
</view>
