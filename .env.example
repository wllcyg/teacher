# 教师工作台 生产环境配置模板
# 复制此文件为 .env：cp .env.example .env

# 登录密码（强烈建议修改为高强度密码）
APP_PASSWORD=YourStrongPasswordHere!2026

# JWT Token 签名密钥（任意长随机字符串，如 openssl rand -hex 32）
APP_SECRET_KEY=generate_a_random_secret_key_here

# 前端访问域名白名单（防跨域拦截，多个逗号分隔）
ALLOWED_ORIGINS=https://yg.cheatppf.xyz

# AI 配置（如果需要使用 AI 生成评语/分析学情功能）
AI_API_KEY=
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen-flash

# ── NestJS 后端专属配置 ──────────────────────────────────────────────
# NestJS 服务端口（默认 3000）
PORT=3000

# SQLite 数据文件目录（默认 ./data）
# 迁移时把 Python 的 teacher.sqlite 复制到此目录即可
DATA_DIR=./data

# 或直接指定 SQLite 文件路径（优先级高于 DATA_DIR）
# DATABASE_URL=sqlite:///path/to/teacher.sqlite

# 额外允许的 AI 域名（防 SSRF，逗号分隔，无需包含 AI_BASE_URL 自带域名）
# AI_ALLOWED_HOSTS=
